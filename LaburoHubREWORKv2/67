    launchAuroraXMain = function()
        ensurePvPInitialized()

        ScreenGui.Enabled = true
        Main.Visible = true
        Window.GroupTransparency = 0
        Glow.ImageTransparency = 0.8
        OutlineStroke.Transparency = 0
        MainScale.Scale = UIScaleValue or 1
        isAnimating = false
        isMinimized = false

        selectTab(TabHome, true)
        task.defer(function()
            selectTab(TabHome, true)
        end)

        notify("Aurora X", "PVP Loaded! By Darling • Press " .. shortKey(MenuKey) .. " to minimize", 3.5)

        -- auto load config
        if canSave then
            local ok, exists = pcall(isfile, AUTOLOAD_FILE)
            if ok and exists then
                local okRead, slot = pcall(readfile, AUTOLOAD_FILE)
                if okRead and type(slot) == "string" and slot ~= "" then
                    if SlotDropdown and SlotDropdown.Set then SlotDropdown.Set(slot, true) end
                    if AutoLoadToggle and AutoLoadToggle.Set then AutoLoadToggle.Set(true, true) end
                    loadConfig(slot, true)
                end
            end
        end
    end

