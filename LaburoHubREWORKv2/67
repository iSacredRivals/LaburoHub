local function createCard(tab, side, titleText, iconId)
    tab.CardCount = tab.CardCount + 1
    local frame = create("Frame", {
        Name = titleText,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = THEME.CardBg,
        BorderSizePixel = 0,
        LayoutOrder = tab.CardCount,
        Parent = (side == "Right") and tab.Right or tab.Left,
    })
    addCorner(frame, 7)
    addStroke(frame, THEME.Border, 1)
    addPadding(frame, 8, 9, 9, 9)
    addList(frame, 7)

    local header = create("Frame", {
        Size = UDim2.new(1, 0, 0, 14),
        BackgroundTransparency = 1,
        LayoutOrder = 0,
        Parent = frame,
    })
    local titleX = 0
    if iconId then
        themed(newIcon(header, iconId, 11, THEME.Accent, {Position = UDim2.new(0, 0, 0.5, -5.5)}), "ImageColor3", "Accent")
        titleX = 16
    end
    local titleLbl = newText(header, titleText, 11, THEME.TextPrimary, Enum.Font.GothamBold, {
        Position = UDim2.fromOffset(titleX, 0), Size = UDim2.new(1, -titleX - 16, 1, 0),
    })
    registerLocalized(titleLbl, titleText)
    local chevron = newIcon(header, ICONS.Chevron, 11, THEME.Accent, {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
    })
    themed(chevron, "ImageColor3", "Accent")

    local card = {Frame = frame, Title = titleText, TitleLabel = titleLbl, HeaderTitle = titleLbl, Tab = tab, Rows = {}, Count = 0, Collapsed = false}

    local headerBtn = create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        Parent = header,
    })
    headerBtn.MouseButton1Click:Connect(function()
        card.Collapsed = not card.Collapsed
        tween(chevron, TWEEN_FAST, {Rotation = card.Collapsed and -90 or 0})
        applyFilter()
    end)

    table.insert(tab.Cards, card)
    table.insert(AllCards, card)
    return card
end

local function newRow(card, name, height)
    card.Count = card.Count + 1
    local row = create("Frame", {
        Name = name,
        Size = UDim2.new(1, 0, 0, height),
        BackgroundTransparency = 1,
        LayoutOrder = card.Count,
        Parent = card.Frame,
    })
    table.insert(card.Rows, {Frame = row, Name = string.lower(name)})
    return row
end

local function flagOf(card, name, opts)
    return (opts and opts.Flag) or (card.Tab.Name .. "/" .. card.Title .. "/" .. name)
end

