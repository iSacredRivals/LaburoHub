        end

        pcall(function()
            local targetTip = CATEGORY_META[cat].Tip
            local char = LocalPlayer.Character
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
            local tools = {}
            if char then
                for _, c in ipairs(char:GetChildren()) do
                    if c:IsA("Tool") and (c.ToolTip == targetTip or tostring(c:GetAttribute("WeaponType")) == targetTip or tostring(c:GetAttribute("ItemType")) == targetTip) then
                        table.insert(tools, c)
                    end
                end
            end
            if bp then
                for _, c in ipairs(bp:GetChildren()) do
                    if c:IsA("Tool") and (c.ToolTip == targetTip or tostring(c:GetAttribute("WeaponType")) == targetTip or tostring(c:GetAttribute("ItemType")) == targetTip) then
                        table.insert(tools, c)
                    end
                end
            end
            for _, tool in ipairs(tools) do
                for _, part in ipairs(tool:GetDescendants()) do
                    if part:IsA("MeshPart") or part:IsA("SpecialMesh") then
                        part.VertexColor = Vector3.new(1, 1, 1)
                    end
                end
            end
        end)

