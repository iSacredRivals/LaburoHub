local function initMusic()
    local currentSound = nil
    local SoundService = game:GetService("SoundService")

    local function getMusicPlayer()
        if currentSound and currentSound.Parent then return currentSound end
        currentSound = Instance.new("Sound")
        currentSound.Name = "AuroraX_MusicPlayer"
        currentSound.Looped = true
        currentSound.Volume = 0.5
        currentSound.Parent = SoundService
        return currentSound
    end

    local PLAYLIST_FILE = "AuroraX/playlist.json"
    local defaultPlaylist = {
        {name = "Aurora Lobby Theme", id = "90089940136467"},
    }

