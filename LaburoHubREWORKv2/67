    connect(RunService.RenderStepped, function(dt)
        frames = frames + 1
        local now = os.clock()

        -- brillo animado en el título (solo activo cuando la ventana está abierta)
        if not isMinimized and Main and Main.Visible then
            TitleGrad.Offset = Vector2.new(math.sin(now * 1.6) * 0.6, 0)
        end

        if now - lastFps >= 1 then
            if Hud.Visible then
                local elapsed = math.max(now - lastFps, 0.001)
                FpsLabel.Text = string.format("%d Fps", math.floor(frames / elapsed))
            end
            frames = 0
            lastFps = now
        end

        if now - lastSlow >= 0.5 then
            lastSlow = now
            if Hud.Visible then
                PingLabel.Text = string.format("%d Ping", getPing())
                TickLabel.Text = string.format("%.1f Ticks", math.clamp(1 / math.max(dt, 0.0001), 0, 60))
                local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local p = root.Position
                    PosLabel.Text = string.format("%d, %d, %d", math.floor(p.X), math.floor(p.Y), math.floor(p.Z))
                    local elapsedPos = math.max(now - lastPosTime, 0.001)
                    local spd = (p - lastPos).Magnitude / elapsedPos
                    SpeedLabel.Text = string.format("%.1f Bps", spd)
                    lastPos = p
                    lastPosTime = now
                end
            end
            if Flags["System/SessionTime"] and setSession then
                setSession(formatTime(now - startTime))
            end
        end

        if Flags["Colors/RainbowUI"] and now - lastRainbow >= 0.05 then
            lastRainbow = now
