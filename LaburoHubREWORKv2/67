    local hotbarSlotCache = {}
    local function findHotbarSlot(cat, itemName)
        cat = cat or S.SelectedCategory or "Fruits"
        itemName = itemName or getTargetItem(cat)

        if hotbarSlotCache[cat] and hotbarSlotCache[cat].img and hotbarSlotCache[cat].img.Parent then
            return hotbarSlotCache[cat].img, hotbarSlotCache[cat].slot
        end

        local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not pGui then return nil, nil end

        local targetLower = string.lower(itemName)
        local targetSlotIdx = CATEGORY_META[cat].Slot

        local function checkContainer(container)
            if not container then return nil, nil end
            for _, slot in ipairs(container:GetChildren()) do
                if slot:IsA("GuiObject") then
                    local matched = false
                    local itemAttr = slot:GetAttribute("ItemName") or slot:GetAttribute("ToolName")
                    if itemAttr and string.lower(tostring(itemAttr)):find(targetLower, 1, true) then
                        matched = true
                    end
                    local title = slot:FindFirstChild("Title")
                    if title and title:IsA("TextLabel") then
                        local t1 = string.lower(title.Text)
                        local sub = title:FindFirstChildOfClass("TextLabel")
                        local t2 = sub and string.lower(sub.Text) or ""
                        if t1:find(targetLower, 1, true) or t2:find(targetLower, 1, true) then
                            matched = true
                        end
                    end
                    if string.lower(slot.Name):find(targetLower, 1, true) then
                        matched = true
                    end
                    if targetLower:find("guitar") and (string.lower(slot.Name):find("guitar") or (itemAttr and string.lower(tostring(itemAttr)):find("guitar"))) then
                        matched = true
                    end
                    if matched then
                        local img = slot:FindFirstChild("Image") or slot:FindFirstChildOfClass("ImageLabel")
                        if img and img:IsA("ImageLabel") then
                            hotbarSlotCache[cat] = { img = img, slot = slot }
                            return img, slot
                        end
                    end
                end
            end
            return nil, nil
        end

        -- Check Backpack containers
        local bpGui = pGui:FindFirstChild("Backpack")
        if bpGui then
            local hotbar = bpGui:FindFirstChild("Hotbar")
            if hotbar then
                local resImg, resSlot = checkContainer(hotbar:FindFirstChild("Container") or hotbar)
                if resImg then return resImg, resSlot end
            end
            local inv = bpGui:FindFirstChild("Inventory")
            if inv then
                local resImg, resSlot = checkContainer(inv:FindFirstChild("Container") or inv)
                if resImg then return resImg, resSlot end
            end
        end

        -- Check Main GUI containers (modern Blox Fruits)
        local mainGui = pGui:FindFirstChild("Main")
        if mainGui then
            local mHotbar = mainGui:FindFirstChild("Hotbar")
            if mHotbar then
                local resImg, resSlot = checkContainer(mHotbar:FindFirstChild("Container") or mHotbar)
                if resImg then return resImg, resSlot end
            end
            local mBottom = mainGui:FindFirstChild("BottomBar")
            if mBottom then
                local resImg, resSlot = checkContainer(mBottom:FindFirstChild("Container") or mBottom)
                if resImg then return resImg, resSlot end
            end
        end

        -- Slot index fallback in Hotbar Container
        local hotbar = (bpGui and bpGui:FindFirstChild("Hotbar")) or (mainGui and mainGui:FindFirstChild("Hotbar"))
        local cont = hotbar and (hotbar:FindFirstChild("Container") or hotbar)
        if cont then
            local slots = {}
            for _, c in ipairs(cont:GetChildren()) do
                if c:IsA("GuiObject") and (c:FindFirstChild("Image") or c:FindFirstChildOfClass("ImageLabel")) then
                    table.insert(slots, c)
                end
            end
            table.sort(slots, function(a, b) return (a.LayoutOrder or 0) < (b.LayoutOrder or 0) end)
            if slots[targetSlotIdx] then
                local img = slots[targetSlotIdx]:FindFirstChild("Image") or slots[targetSlotIdx]:FindFirstChildOfClass("ImageLabel")
                if img and img:IsA("ImageLabel") then
                    hotbarSlotCache[cat] = { img = img, slot = slots[targetSlotIdx] }
                    return img, slots[targetSlotIdx]
                end
            end
        end

        return nil, nil
    end

