    register(flag .. "@key", opts.Key and opts.Key.Name or "", function(v)
        if type(v) == "string" and v ~= "" then
            local ok, kc = pcall(function() return Enum.KeyCode[v] end)
            obj.SetKey(ok and kc or nil)
        else
            obj.SetKey(nil)
        end
    end)

    obj.Value = opts.Default or false
    render(true)
    obj.SetKey(opts.Key)
    if opts.Default and opts.Callback then
        task.spawn(opts.Callback, true)
    end
    table.insert(KeyToggles, obj)
    return obj
