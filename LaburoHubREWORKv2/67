    -- 3. Aim Center calculation
    local function getAimCenter()
        local cam = workspace.CurrentCamera
        if not cam then return Vector2.zero end
        if BF_Combat.FovFollowsMouse then
            local m = UserInputService:GetMouseLocation()
            return Vector2.new(m.X, m.Y)
        else
            return Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
        end
    end

    -- 3. FOV & Target Evaluation Math
    local function isInFov(screenPos, center, radius)
        return (screenPos - center).Magnitude <= radius
    end

    local function getAimScore(part, dist)
        local cam = workspace.CurrentCamera
        if not cam or not part then return nil end
        local spos, onScreen = cam:WorldToViewportPoint(part.Position)
        local screenPos = Vector2.new(spos.X, spos.Y)
        local center = getAimCenter()

        if BF_Combat.AimMode == "FOV" then
            if not onScreen or spos.Z <= 0 then return nil end
            local fovRad = BF_Combat.FovRadius or 150
            if not isInFov(screenPos, center, fovRad) then return nil end
            return (screenPos - center).Magnitude
        elseif BF_Combat.AimMode == "180" then
            if not onScreen or spos.Z <= 0 then return nil end
            return (screenPos - center).Magnitude + (dist * 0.1)
        else
            -- 360 Mode (Infinite angle): strictly distance based
            return dist
        end
    end

    local function getTargetPart(character, partName)
        if not character then return nil end
        partName = partName or BF_Combat.TargetPart or "HumanoidRootPart"
        return character:FindFirstChild(partName) or character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head") or character.PrimaryPart
    end

    local function isBloxFruitsAlly(targetPlayer)
        if not targetPlayer or targetPlayer == LocalPlayer then return false end
        local myTeam = LocalPlayer.Team
        local targetTeam = targetPlayer.Team
        if myTeam and targetTeam and myTeam.Name == "Marines" and targetTeam.Name == "Marines" then
