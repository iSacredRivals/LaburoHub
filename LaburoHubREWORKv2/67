    local function performTrackerTP()
        local cChar = LocalPlayer.Character
        local cHRP = cChar and cChar:FindFirstChild("HumanoidRootPart")
        if not cHRP or not trackerLockedChar then return end
        local tHrp = trackerLockedChar:FindFirstChild("HumanoidRootPart") or trackerLockedChar:FindFirstChild("UpperTorso") or trackerLockedChar:FindFirstChild("Torso")
        local tHum = trackerLockedChar:FindFirstChildOfClass("Humanoid")
        if not tHrp or not trackerLockedChar.Parent or (tHum and tHum.Health <= 0) then
            notify("Tracker", "Target lost / eliminated", 2)
            stopTracking(true)
            return
        end
        if (cHRP.Position - tHrp.Position).Magnitude <= TRACK_MAX_DIST then
            cHRP.CFrame = tHrp.CFrame * CFrame.new(0, 0, G.TrackerDist or 3.5)
            cHRP.AssemblyLinearVelocity = Vector3.zero
        end
    end

