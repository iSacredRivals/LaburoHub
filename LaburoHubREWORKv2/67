    if unloaded then return end
    unloaded = true
    BindListener = nil
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    pcall(function() RunService:UnbindFromRenderStep("AuroraX_SilentAim") end)
    pcall(function() RunService:UnbindFromRenderStep("AuroraX_CamLock") end)
    _G.G_SilentAimTargetPos = nil
