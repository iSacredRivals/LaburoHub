    local function applySkinToCategory(cat, skin, suppressNotify)
        cat = cat or S.SelectedCategory or "Fruits"
        local itemName = getTargetItem(cat)
        local img, slot = findHotbarSlot(cat, itemName)
        local customAsset = (cat == "Fruits") and getCustomFruitAsset(itemName) or nil

        if img then
            if not cachedCategoryImages[cat] then cachedCategoryImages[cat] = {} end
            if not cachedCategoryImages[cat][img] then
                cachedCategoryImages[cat][img] = {
                    Image = img.Image,
                    ImageColor3 = img.ImageColor3,
                    ImageRectOffset = img.ImageRectOffset,
                    ImageRectSize = img.ImageRectSize,
                    ScaleType = img.ScaleType,
                }
            end

            if customAsset then
                img.Image = customAsset
                img.ImageRectOffset = Vector2.zero
                img.ImageRectSize = Vector2.zero
                img.ScaleType = Enum.ScaleType.Fit
            end
            img.ImageColor3 = skin.Color

            if categoryListeners[cat] then
                pcall(function() categoryListeners[cat]:Disconnect() end)
            end
            categoryListeners[cat] = img:GetPropertyChangedSignal("Image"):Connect(function()
                local eq = equippedSkins[cat]
                if eq and eq.Color then
                    if customAsset and img.Image ~= customAsset then
                        img.Image = customAsset
                        img.ImageRectOffset = Vector2.zero
                        img.ImageRectSize = Vector2.zero
                        img.ScaleType = Enum.ScaleType.Fit
                    end
                    img.ImageColor3 = eq.Color
                end
            end)
        end

        pcall(function()
            local targetTip = CATEGORY_META[cat].Tip
            local tools = {}
            local char = LocalPlayer.Character
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
            if char then
                for _, c in ipairs(char:GetChildren()) do
                    if c:IsA("Tool") and (string.lower(c.Name) == string.lower(itemName) or c.ToolTip == targetTip or tostring(c:GetAttribute("WeaponType")) == targetTip or tostring(c:GetAttribute("ItemType")) == targetTip) then
                        table.insert(tools, c)
                    end
                end
            end
            if bp then
                for _, c in ipairs(bp:GetChildren()) do
                    if c:IsA("Tool") and (string.lower(c.Name) == string.lower(itemName) or c.ToolTip == targetTip or tostring(c:GetAttribute("WeaponType")) == targetTip or tostring(c:GetAttribute("ItemType")) == targetTip) then
                        table.insert(tools, c)
                    end
                end
            end
            for _, tool in ipairs(tools) do
                if customAsset then tool.TextureId = customAsset end
                for _, part in ipairs(tool:GetDescendants()) do
                    if part:IsA("SpecialMesh") then
                        part.VertexColor = Vector3.new(skin.Color.R, skin.Color.G, skin.Color.B)
                    elseif part:IsA("BasePart") then
                        part.Color = skin.Color
                    end
                end
            end
        end)

        equippedSkins[cat] = {
            Name = skin.Name,
            Color = skin.Color,
            ItemName = itemName,
            Asset = customAsset,
        }

        S.ActiveSkinName = skin.Name
        S.ActiveSkinColor = skin.Color
        S.FruitIconCustom = (cat == "Fruits")

        -- INDEPENDENT CATEGORY VFX:
        -- Sword slashes turn blue, fruit skills turn green, guns turn red, etc.!
        if not suppressNotify then
            if _G.AuroraX_SetCategorySkinVFX then
                pcall(_G.AuroraX_SetCategorySkinVFX, cat, skin.Color, skin.Name, false)
            end
            updateCategoryUI()
            notify(cat .. " Skin", skin.Name .. " applied to " .. itemName .. " & " .. cat .. " VFX updated!", 2)
        end
        return true
    end

