    local function checkKeyAPI(keyStr)
        local rawKey = (keyStr or ""):gsub("%s+", "")
        if #rawKey == 0 then
            return false, "empty_key", "Please enter a key."
        end
        local hwid = getDeviceHWID()
        local url = "https://aurorax.site/api/check?key=" .. rawKey .. "&hwid=" .. tostring(hwid)
        local body = nil
        local ok = pcall(function()
            if game.HttpGet then
                body = game:HttpGet(url)
            elseif request then
                local res = request({Url = url, Method = "GET"})
                body = res and res.Body
            elseif http_request then
                local res = http_request({Url = url, Method = "GET"})
                body = res and res.Body
            end
        end)

        if not ok or not body or body == "" then
            return false, "connection_error", "Could not reach aurorax.site"
        end

        local data = nil
        local parseOk = pcall(function()
            data = game:GetService("HttpService"):JSONDecode(body)
        end)

        if not parseOk or type(data) ~= "table" then
            return false, "decode_error", "Server response parse error."
        end

        if data.success == true then
            return true, data, nil
        else
            local code = data.code or "invalid_key"
            local msg = "Invalid key."
            if code == "invalid_key" then
                msg = "Invalid key or bad format!"
            elseif code == "expired" then
                msg = "Key lifetime has expired!"
            elseif code == "revoked" then
                msg = "Key was revoked by admin!"
            elseif code == "hwid_mismatch" then
                msg = "HWID mismatch! Reset key on site."
            end
            return false, code, msg
        end
    end

