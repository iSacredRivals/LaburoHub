    local function getLocalized(key)
        if not key or key == "" then return "" end
        if CURRENT_LANG == "English" then return key end
        local dict = TRANSLATIONS[CURRENT_LANG]
        if dict and dict[key] then return dict[key] end
        return key
    end

    local function registerLocalized(lbl, key)
        if not lbl or not key or key == "" then return end
        table.insert(LocalizedLabels, { Label = lbl, Key = key })
        if CURRENT_LANG ~= "English" then
            local t = getLocalized(key)
            if t and t ~= key then
                pcall(function() lbl.Text = t end)
            end
        end
    end

    local function setLanguage(lang)
        CURRENT_LANG = lang or "English"
        for _, item in ipairs(LocalizedLabels) do
            if item.Label and item.Label.Parent then
                local t = getLocalized(item.Key)
                pcall(function() item.Label.Text = t end)
            end
        end
        if ActiveTab and TabPathLabel then
            TabPathLabel.Text = "›   " .. getLocalized(ActiveTab.Name)
        end
    end

    return {
        getLocalized = getLocalized,
        registerLocalized = registerLocalized,
        setLanguage = setLanguage
    }
end)()

getLocalized = AuroraX_I18N.getLocalized
registerLocalized = AuroraX_I18N.registerLocalized
setLanguage = AuroraX_I18N.setLanguage

local function selectTab(tab, force)
    if not tab then return end
    if ActiveTab == tab and not force then return end
    closePopup()
    for _, t in ipairs(Tabs) do
        if t ~= tab and t.Page then
            t.Page.Visible = false
            setTabVisual(t, false)
        end
    end
    ActiveTab = tab
    setTabVisual(tab, true)
    TabPathLabel.Text = "›   " .. getLocalized(tab.Name)
    tab.Page.Position = UDim2.fromOffset(0, 8)
    tab.Page.Visible = true
    if tab.Name == "Player List" and type(_G.AuroraX_RefreshPlayerList) == "function" then
        task.spawn(_G.AuroraX_RefreshPlayerList)
    end
    tween(tab.Page, TWEEN_SLOW, {Position = UDim2.fromOffset(0, 0)})
end

