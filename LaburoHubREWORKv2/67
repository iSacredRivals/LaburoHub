    -- =========================================================================
    -- ANTI STUN CORE (Aurora Defense Engine)
    -- =========================================================================
    local AntiStunActive = false
    local StunConnections = {}
    local CurrentStunChar = nil
    local CurrentStunRoot = nil
    local StunObject = nil
    local StunConn = nil
    local AttrTimes = { Character = {}, HRP = {} }
    local HostileUntil = 0

    local HostileAttrsChar = { LastDamageTick = true, LastDamageTakenAt = true, InCombat = true }
    local HostileAttrsHRP = {
        LastDetectedDuration = true, LastDetectedTimestamp = true, LastDetectedPriority = true,
        LastDetectedVelocity = true, LastDetectedKnockback = true, LastStunAnimation = true, IdleStunCounter = true
    }

    local function cancelHostileMovers()
        if not AntiStunActive or not CurrentStunRoot then return end
        pcall(function()
            for _, m in ipairs(CurrentStunRoot:GetChildren()) do
                if (m:IsA("BodyVelocity") or m:IsA("BodyPosition") or m:IsA("BodyGyro")) and m.Name ~= "RootVelocity" and m.Name ~= "Keep" then
                    pcall(function() m:Destroy() end)
                end
            end
        end)
    end

    local function onStunChanged()
        if not AntiStunActive or not StunObject then return end
        local val = tonumber(StunObject.Value) or 0
        if val > 0 then
            local now = os.clock()
            local recentDmg = math.max(AttrTimes.Character.LastDamageTick or 0, AttrTimes.Character.LastDamageTakenAt or 0)
            local isHostile = (now - recentDmg <= 0.35) or (now <= HostileUntil)
            if isHostile then
                StunObject.Value = 0
                cancelHostileMovers()
            end
        end
    end

    local function cleanupAntiStunChar()
        for _, c in ipairs(StunConnections) do pcall(function() c:Disconnect() end) end
        table.clear(StunConnections)
        if StunConn then pcall(function() StunConn:Disconnect() end); StunConn = nil end
        StunObject = nil
        CurrentStunRoot = nil
        CurrentStunChar = nil
    end

    local function bindAntiStun(char)
        cleanupAntiStunChar()
        if not char or not char.Parent then return end
        CurrentStunChar = char
        CurrentStunRoot = char:FindFirstChild("HumanoidRootPart")
        AttrTimes = { Character = {}, HRP = {} }

        table.insert(StunConnections, char.AttributeChanged:Connect(function(attr)
            if HostileAttrsChar[attr] then
                local now = os.clock()
                AttrTimes.Character[attr] = now
                HostileUntil = now + 0.35
                cancelHostileMovers()
                if StunObject and (tonumber(StunObject.Value) or 0) > 0 then
                    StunObject.Value = 0
                end
            end
        end))

        if CurrentStunRoot then
            table.insert(StunConnections, CurrentStunRoot.AttributeChanged:Connect(function(attr)
                if HostileAttrsHRP[attr] then
                    local now = os.clock()
                    AttrTimes.HRP[attr] = now
                    HostileUntil = now + 0.35
                    cancelHostileMovers()
                end
            end))
        end

        local function watchChild(child)
            if child.Name == "Stun" and child:IsA("NumberValue") then
                StunObject = child
                if StunConn then pcall(function() StunConn:Disconnect() end) end
                StunConn = child.Changed:Connect(onStunChanged)
                onStunChanged()
            elseif child.Name == "HumanoidRootPart" then
                CurrentStunRoot = child
            end
        end

        table.insert(StunConnections, char.ChildAdded:Connect(watchChild))
        table.insert(StunConnections, char.ChildRemoved:Connect(function(child)
            if child == StunObject then
                if StunConn then pcall(function() StunConn:Disconnect() end); StunConn = nil end
                StunObject = nil
            end
        end))

        local existingStun = char:FindFirstChild("Stun")
        if existingStun and existingStun:IsA("NumberValue") then
            watchChild(existingStun)
        end
    end

    local function setAntiStun(enabled)
        AntiStunActive = (enabled == true)
        if AntiStunActive then
            bindAntiStun(LocalPlayer.Character)
        else
            cleanupAntiStunChar()
        end
    end

    connect(LocalPlayer.CharacterAdded, function(newChar)
        if AntiStunActive then
            task.delay(0.2, function()
                if AntiStunActive then bindAntiStun(newChar) end
            end)
        end
    end)

    -- =========================================================================
    -- GUN AURA ENGINE (High-Speed Universal Autofire)
    -- =========================================================================
    local ShootGunEvent = nil
    local Validator2 = nil
    local ShootFunction = nil
    local V_Idx = { v26 = 12, v22 = 13, v25 = 14, v21 = 15, v23 = 16, v24 = 17, v27 = 18 }
    local getupval  = debug.getupvalue or getupvalue
    local setupval  = debug.setupvalue or setupvalue
    local getupvals = debug.getupvalues or getupvalues

    local function resolveGunRemotes()
        if not ShootGunEvent then
            pcall(function()
                local modules = ReplicatedStorage:FindFirstChild("Modules")
                local net = modules and modules:FindFirstChild("Net")
                if net then ShootGunEvent = net:FindFirstChild("RE/ShootGunEvent") end
            end)
        end
        if not Validator2 then
            pcall(function()
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes then Validator2 = remotes:FindFirstChild("Validator2") end
            end)
        end
        return ShootGunEvent
    end

    local function InitGunValidator()
        pcall(function()
            local controllers = ReplicatedStorage:FindFirstChild("Controllers")
            local combat = controllers and controllers:FindFirstChild("CombatController")
            if combat then
                local res = require(combat)
                if type(res) == "table" and res.Attack and getupval then
                    ShootFunction = getupval(res.Attack, 9)
                end
            end
        end)
    end

    local function GetNextValidator()
        if not ShootFunction then InitGunValidator() end
        if not ShootFunction or not getupvals or not setupval or not getupval then return 0, 0 end
        local upvals = getupvals(ShootFunction)
        if not upvals then return 0, 0 end
        if upvals[V_Idx.v21] ~= 727595 then
            for i, v in pairs(upvals) do
                if v == 727595 then
                    local offset = i - 15
                    V_Idx.v21 = i; V_Idx.v22 = 13 + offset; V_Idx.v23 = 16 + offset
                    V_Idx.v24 = 17 + offset; V_Idx.v26 = 12 + offset; V_Idx.v25 = 14 + offset
                    V_Idx.v27 = 18 + offset
                    break
                end
            end
        end
        local v1 = getupval(ShootFunction, V_Idx.v21)
        local v2 = getupval(ShootFunction, V_Idx.v22)
        local v3 = getupval(ShootFunction, V_Idx.v23)
        local v4 = getupval(ShootFunction, V_Idx.v24)
        local v5 = getupval(ShootFunction, V_Idx.v25)
        local v6 = getupval(ShootFunction, V_Idx.v26)
        local v7 = getupval(ShootFunction, V_Idx.v27)
        if not (v1 and v2 and v3 and v4 and v5 and v6 and v7) then return 0, 0 end
        local v8 = v6 * v2
        local v9 = (v5 * v2 + v6 * v1) % v3
        v9 = (v9 * v3 + v8) % v4
        v5 = math.floor(v9 / v3)
        v6 = v9 - v5 * v3
        v7 = v7 + 1
        setupval(ShootFunction, V_Idx.v25, v5)
        setupval(ShootFunction, V_Idx.v26, v6)
        setupval(ShootFunction, V_Idx.v27, v7)
        return math.floor(v9 / v4 * 16777215), v7
    end

    local function getEquippedOrBackpackGun()
        local char = LocalPlayer.Character
        if not char then return nil end
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and (item.ToolTip == "Gun" or item:GetAttribute("WeaponType") == "Gun" or item:GetAttribute("Type") == "Gun" or item:FindFirstChild("ShootGunEvent")) then
                return item
            end
        end
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        if bp then
            for _, item in ipairs(bp:GetChildren()) do
                if item:IsA("Tool") and (item.ToolTip == "Gun" or item:GetAttribute("WeaponType") == "Gun" or item:GetAttribute("Type") == "Gun" or item:FindFirstChild("ShootGunEvent")) then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then hum:EquipTool(item) end
                    return item
                end
            end
        end
        return nil
    end

    local function getGunAuraTarget()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        local myPos = root.Position
        local closest, dist = nil, 400

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
                local pHum = p.Character:FindFirstChildOfClass("Humanoid")
                if pHrp and pHum and pHum.Health > 0 then
                    local pvpOff = p:GetAttribute("PvpDisabled") == true or p.Character:GetAttribute("PvpDisabled") == true or p.Character:FindFirstChildOfClass("ForceField")
                    if not pvpOff then
                        local d = (pHrp.Position - myPos).Magnitude
                        if d < dist then dist = d; closest = pHrp end
                    end
                end
            end
        end
        if closest then return closest end

        local enemies = workspace:FindFirstChild("Enemies")
        if enemies then
            for _, e in ipairs(enemies:GetChildren()) do
                local eHrp = e:FindFirstChild("HumanoidRootPart") or e.PrimaryPart
                local eHum = e:FindFirstChildOfClass("Humanoid")
                if eHrp and eHum and eHum.Health > 0 then
                    local d = (eHrp.Position - myPos).Magnitude
                    if d < dist then dist = d; closest = eHrp end
                end
            end
        end
        return closest
    end

    local lastGunAuraTick = 0
    LPH_NO_VIRTUALIZE(function()
        connect(RunService.Heartbeat, function()
            if not G.GunAura then return end
            local now = os.clock()
            if now - lastGunAuraTick < 0.07 then return end
            lastGunAuraTick = now

            local tool = getEquippedOrBackpackGun()
            if not tool then return end

            local target = getGunAuraTarget()
            if not (target and target.Parent) then return end

            pcall(function()
                resolveGunRemotes()
                if Validator2 then
                    local code, count = GetNextValidator()
                    if code ~= 0 then
                        pcall(function() Validator2:FireServer(code, count) end)
                    end
                end
                tool:SetAttribute("LocalOverheat", 0)
                tool:SetAttribute("LocalTotalShots", (tool:GetAttribute("LocalTotalShots") or 0) + 1)

                local sEv = tool:FindFirstChild("ShootGunEvent") or ShootGunEvent
                if sEv then
                    pcall(function() sEv:FireServer(target.Position, { [1] = target, target }) end)
                end
                pcall(function() tool:Activate() end)
            end)
        end)
