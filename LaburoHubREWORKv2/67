        trackerLockedChar = char
        trackingActive = true
        trackerUpdateVisual()
        notify("Tracker", "Locked onto: " .. (plr and plr.DisplayName or char.Name), 1.5)
        performTrackerTP()
        if trackerConn then trackerConn:Disconnect() end
        trackerConn = RunService.Heartbeat:Connect(function()
