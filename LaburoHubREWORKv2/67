    BF_Combat.Prediction = false

    -- Smart Prediction
    local function getPredictedTargetPos(targetPart)
        if not targetPart then return nil end
        local char = targetPart.Parent
        local tHrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
        if not tHrp then return targetPart.Position end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return targetPart.Position end

        if not BF_Combat.Prediction then return targetPart.Position end

        local vel = tHrp.AssemblyLinearVelocity or tHrp.Velocity or Vector3.zero
        local speed = vel.Magnitude
        if speed < 2.5 then return targetPart.Position end

        local ping = 0
        pcall(function()
            local ps = Stats:FindFirstChild("Network") and Stats.Network:FindFirstChild("ServerStatsItem")
            local dp = ps and ps:FindFirstChild("Data Ping")
            if dp then
                ping = dp:GetValue() / 1000
            elseif LocalPlayer.GetNetworkPing then
                ping = LocalPlayer:GetNetworkPing()
            end
        end)
        ping = math.clamp(ping, 0, 0.35)
        local factor = 0.12 + ping
        if speed > 100 then factor = math.min(factor, 0.15) end
        return targetPart.Position + (vel * factor)
    end

    -- Character Alignment: Strict horizontal yaw orientation (NEVER tilts or turns player sideways!)
    local function faceTarget(targetPos)
        if not targetPos then return end
        local myChar = LocalPlayer.Character
        local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)
        if not myHrp then return end
        local curPos = myHrp.Position
        local flatTarget = Vector3.new(targetPos.X, curPos.Y, targetPos.Z)
        if (flatTarget - curPos).Magnitude > 0.5 then
            myHrp.CFrame = CFrame.lookAt(curPos, flatTarget)
        end
    end

    -- Global Silent Aim state initialization
    _G.G_SilentAimTargetPos = nil
