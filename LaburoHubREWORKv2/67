    local function loadPlaylist()
        userPlaylist = {}
        for _, item in ipairs(defaultPlaylist) do
            table.insert(userPlaylist, {name = item.name, id = item.id})
        end
        if canSave and isfile and isfile(PLAYLIST_FILE) then
            pcall(function()
                local raw = readfile(PLAYLIST_FILE)
                local data = HttpService:JSONDecode(raw)
                if type(data) == "table" then
                    for _, v in ipairs(data) do
                        if v.name and v.id then
                            table.insert(userPlaylist, {name = tostring(v.name), id = tostring(v.id)})
                        end
                    end
                end
            end)
        end
    end
    loadPlaylist()

    local function savePlaylist()
        if canSave and writefile then
            pcall(function()
                ensureFolder()
                local raw = HttpService:JSONEncode(userPlaylist)
                writefile(PLAYLIST_FILE, raw)
            end)
        end
    end

    local function getPlaylistNames()
        local names = {}
        for _, item in ipairs(userPlaylist) do
            table.insert(names, item.name)
        end
