local function initEsp()
    _G.AuroraX_ESP = _G.AuroraX_ESP or {
        Names        = false,
        Fruit        = false,
        Bounty       = false,
        Health       = false,
        Distance     = false,
        Weapons      = false,
        Boxes        = false,
        BoxStyle     = "2D Box",
        Chams        = false,
        Npc          = false,
        MaxDistance  = 1500,
    }
    local E = _G.AuroraX_ESP

    local espCache = {}
    local playerCache = {}

    local function safeXml(s)
        return tostring(s or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&apos;")
    end

    local NPC_BLOCK_WORDS = {"quest", "dealer", "shop", "citizen", "trainer", "agent", "scientist",
        "manager", "set home", "starter", "gacha", "alchemist", "swapper", "dummy", "dialog", "talk"}
    local npcHostileCache = setmetatable({}, {__mode = "k"})
    local function isValidNpcTarget(mob)
        if not mob or not mob.Parent then return false end
        local cached = npcHostileCache[mob]
        if cached ~= nil then return cached end
        local ok = true
        if Players:GetPlayerFromCharacter(mob) then ok = false end
        if ok then
            local n = string.lower(mob.Name)
            for _, w in ipairs(NPC_BLOCK_WORDS) do
                if n:find(w, 1, true) then ok = false; break end
            end
        end
        if ok then
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            if (hrp and hrp.Anchored) or mob:FindFirstChild("Dialogue") or mob:FindFirstChild("QuestGiver") then
                ok = false
            end
        end
        npcHostileCache[mob] = ok
        return ok
    end

    local function cleanESP(target)
        local data = espCache[target]
        if data then
            if data.bb then pcall(function() data.bb:Destroy() end) end
            if data.boxBb then pcall(function() data.boxBb:Destroy() end) end
            if data.hl then pcall(function() data.hl:Destroy() end) end
            espCache[target] = nil
        end
    end

    local function cleanAllESP()
        for target, _ in pairs(espCache) do
            cleanESP(target)
        end
    end

    local function getPlayerData(plr)
        local data = playerCache[plr]
        local now = tick()
        if not data or (now - (data.lastUpdate or 0) > 4) then
            data = {
                level = "?",
                fruit = "None",
                bounty = 0,
                team = "Pirates",
                lastUpdate = now
            }
            pcall(function()
                local d = plr:FindFirstChild("Data")
                if d then
                    local lv = d:FindFirstChild("Level")
                    if lv then data.level = tostring(lv.Value) end
                    local fr = d:FindFirstChild("DevilFruit")
                    if fr then data.fruit = tostring(fr.Value):gsub(" Fruit", ""):gsub("-.*", "") end
                end
                local ls = plr:FindFirstChild("leaderstats")
                if ls then
                    local b = ls:FindFirstChild("Bounty/Honor") or ls:FindFirstChild("Bounty")
                    if b then data.bounty = tonumber(b.Value) or 0 end
                end
                if plr.Team then data.team = plr.Team.Name end
            end)
            playerCache[plr] = data
        end
        return data
    end

    local function formatBounty(b)
        b = tonumber(b) or 0
        if b >= 1000000 then
            return string.format("%.1fM", b / 1000000)
        elseif b >= 1000 then
            return string.format("%.1fK", b / 1000)
        end
        return tostring(b)
    end

    local function updateWorldESP()
        local cam = workspace.CurrentCamera
        local myChar = LocalPlayer.Character
        local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)
        if not cam or not myHrp then return end
        local myPos = myHrp.Position

        local anyTextActive = E.Names or E.Fruit or E.Bounty or E.Health or E.Distance or E.Weapons
        local anyPlayerActive = anyTextActive or E.Boxes or E.Chams
        local anyActive = anyPlayerActive or E.Npc

        if not anyActive then
            if next(espCache) ~= nil then cleanAllESP() end
            return
        end

        local maxDist = E.MaxDistance or 1500

        -- 1. PLAYERS ESP
        if anyPlayerActive then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    local pChar = plr.Character
                    local pHrp = pChar and (pChar:FindFirstChild("HumanoidRootPart") or pChar.PrimaryPart)
                    local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")

                    if pHrp and pHum and pHum.Health > 0 then
                        local dist = (myPos - pHrp.Position).Magnitude
                        if dist <= maxDist then
                            local data = espCache[plr]
                            if not data or not data.bb or not data.bb.Parent or not data.boxBb or not data.boxBb.Parent then
                                cleanESP(plr)

                                -- Billboard on Head / HumanoidRootPart (Anchored above head to avoid rendering at feet)
                                local bb = Instance.new("BillboardGui")
                                bb.Name = "AuroraX_ESP_Player"
                                bb.Adornee = pChar:FindFirstChild("Head") or pHrp
                                bb.Size = UDim2.new(0, 240, 0, 58)
                                bb.SizeOffset = Vector2.new(0, 0.5)
                                bb.StudsOffset = Vector3.new(0, 1.8, 0)
                                bb.AlwaysOnTop = true
                                bb.MaxDistance = maxDist
                                bb.Parent = pHrp

                                local textLbl = Instance.new("TextLabel", bb)
                                textLbl.Name = "InfoLabel"
                                textLbl.Size = UDim2.fromScale(1, 1)
                                textLbl.BackgroundTransparency = 1
                                textLbl.RichText = true
                                textLbl.Font = Enum.Font.GothamBold
                                textLbl.TextSize = 10.5
                                textLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                                textLbl.TextStrokeTransparency = 0
                                textLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                                textLbl.TextYAlignment = Enum.TextYAlignment.Center

                                -- 2D Box BillboardGui
                                local boxBb = Instance.new("BillboardGui")
                                boxBb.Name = "AuroraX_ESP_Box"
                                boxBb.Adornee = pHrp
                                boxBb.Size = UDim2.new(4.2, 0, 5.8, 0)
                                boxBb.AlwaysOnTop = true
                                boxBb.MaxDistance = maxDist
                                boxBb.Parent = pHrp

                                local boxFrame = Instance.new("Frame", boxBb)
                                boxFrame.Name = "BoxFrame"
                                boxFrame.Size = UDim2.fromScale(1, 1)
                                boxFrame.BackgroundTransparency = 1
                                local boxStroke = Instance.new("UIStroke", boxFrame)
                                boxStroke.Color = THEME.Accent
                                boxStroke.Thickness = 1.4

                                local hpBg = Instance.new("Frame", boxBb)
                                hpBg.Name = "HpBg"
                                hpBg.Size = UDim2.new(0.08, 0, 1, 0)
                                hpBg.Position = UDim2.new(-0.12, 0, 0, 0)
                                hpBg.BackgroundColor3 = Color3.fromRGB(16, 16, 18)
                                hpBg.BorderSizePixel = 0
                                local hpFill = Instance.new("Frame", hpBg)
                                hpFill.Name = "HpFill"
                                hpFill.Size = UDim2.fromScale(1, 1)
                                hpFill.BackgroundColor3 = Color3.fromRGB(60, 230, 100)
                                hpFill.BorderSizePixel = 0

                                local hl = nil
                                if E.Chams then
                                    hl = Instance.new("Highlight")
                                    hl.Name = "AuroraX_PlayerHighlight"
                                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                    hl.FillColor = THEME.Accent
                                    hl.FillTransparency = 0.55
                                    hl.OutlineColor = THEME.Accent
                                    hl.OutlineTransparency = 0.1
                                    hl.Adornee = pChar
                                    hl.Parent = pChar
                                end

                                data = { bb = bb, label = textLbl, boxBb = boxBb, boxFrame = boxFrame, boxStroke = boxStroke, hpBg = hpBg, hpFill = hpFill, hl = hl }
                                espCache[plr] = data
                            end

                            local pData = getPlayerData(plr)
                            local hpPct = math.clamp(pHum.Health / math.max(pHum.MaxHealth, 1), 0, 1)
                            local hpInt = math.floor(hpPct * 100)

                            local wepName = ""
                            local tool = pChar:FindFirstChildOfClass("Tool")
                            if tool then wepName = (tool.Name:gsub(" Fruit", "")) end

                            -- Dynamic multi-line text with authentic Blox Fruits colors
                            local lines = {}

                            -- 1. Name & Level Line
                            if E.Names then
                                local teamCol = (pData.team == "Marines") and "#4DA6FF" or (pData.team == "Pirates" and "#FF5555" or "#00FFAA")
                                lines[#lines + 1] = string.format('<font color="%s">%s</font> <font color="#FFD700">[Lv.%s]</font>', teamCol, safeXml(plr.DisplayName), tostring(pData.level))
                            end

                            -- 2. Fruit Line
                            if E.Fruit and pData.fruit and pData.fruit ~= "None" then
                                lines[#lines + 1] = string.format('<font color="#D2A0FF">Fruit: %s</font>', safeXml(pData.fruit))
                            end

                            -- 3. Bounty Line
                            if E.Bounty and pData.bounty and pData.bounty > 0 then
                                lines[#lines + 1] = string.format('<font color="#FFB432">Bounty: $%s</font>', formatBounty(pData.bounty))
                            end

                            -- 4. Distance, HP, Weapon Line
                            local tagParts = {}
                            if E.Distance then
                                tagParts[#tagParts + 1] = string.format('<font color="#66CCFF">%dst</font>', math.floor(dist))
                            end
                            if E.Health then
                                local hpColorHex = (hpInt > 50) and "#44EE66" or (hpInt > 25 and "#FFAA33" or "#FF3333")
                                tagParts[#tagParts + 1] = string.format('<font color="%s">HP: %d%%</font>', hpColorHex, hpInt)
                            end
                            if E.Weapons and wepName ~= "" then
                                tagParts[#tagParts + 1] = string.format('<font color="#FF9999">%s</font>', safeXml(wepName))
                            end
                            if #tagParts > 0 then
                                lines[#lines + 1] = table.concat(tagParts, " | ")
                            end

                            if #lines > 0 then
                                data.label.Text = table.concat(lines, "\n")
                                data.bb.Enabled = true
                            else
                                data.label.Text = ""
                                data.bb.Enabled = false
                            end
                            data.bb.MaxDistance = maxDist
                            data.boxBb.MaxDistance = maxDist

                            -- 2. Box & Health Bar
                            local isBoxOn = (E.Boxes == true)
                            data.boxFrame.Visible = isBoxOn
                            data.boxStroke.Color = THEME.Accent
                            data.hpBg.Visible = isBoxOn
                            if isBoxOn then
                                data.hpFill.Size = UDim2.fromScale(1, hpPct)
                                data.hpFill.Position = UDim2.fromScale(0, 1 - hpPct)
                                data.hpFill.BackgroundColor3 = Color3.fromHSV(hpPct * 0.33, 0.9, 0.95)
                            end

                            -- 3. Chams
                            if E.Chams then
                                if not data.hl or not data.hl.Parent then
                                    local hl = Instance.new("Highlight")
                                    hl.Name = "AuroraX_PlayerHighlight"
                                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                    hl.FillColor = THEME.Accent
                                    hl.FillTransparency = 0.55
                                    hl.OutlineColor = THEME.Accent
                                    hl.OutlineTransparency = 0.1
                                    hl.Adornee = pChar
                                    hl.Parent = pChar
                                    data.hl = hl
                                else
                                    data.hl.FillColor = THEME.Accent
                                    data.hl.OutlineColor = THEME.Accent
                                    data.hl.Enabled = true
                                end
                            elseif data.hl then
                                data.hl.Enabled = false
                            end
                        else
                            cleanESP(plr)
                        end
                    else
                        cleanESP(plr)
                    end
                end
            end
        else
            for _, plr in ipairs(Players:GetPlayers()) do cleanESP(plr) end
        end

        -- 2. HOSTILE NPCS ESP
        if E.Npc then
            local npcFolder = workspace:FindFirstChild("Enemies")
            if npcFolder then
                for _, mob in ipairs(npcFolder:GetChildren()) do
                    if mob:IsA("Model") and isValidNpcTarget(mob) then
                        local mHrp = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
                        local mHum = mob:FindFirstChildOfClass("Humanoid")
                        if mHrp and mHum and mHum.Health > 0 then
                            local dist = (myPos - mHrp.Position).Magnitude
                            if dist <= maxDist then
                                local data = espCache[mob]
                                if not data or not data.bb or not data.bb.Parent then
                                    local bb = Instance.new("BillboardGui")
                                    bb.Name = "AuroraX_ESP_NPC"
                                    bb.Adornee = mob:FindFirstChild("Head") or mHrp
                                    bb.Size = UDim2.new(0, 160, 0, 32)
                                    bb.SizeOffset = Vector2.new(0, 0.5)
                                    bb.StudsOffset = Vector3.new(0, 1.8, 0)
                                    bb.AlwaysOnTop = true
                                    bb.MaxDistance = maxDist
                                    bb.Parent = mHrp

                                    local nameLbl = Instance.new("TextLabel", bb)
                                    nameLbl.Size = UDim2.fromScale(1, 1)
                                    nameLbl.BackgroundTransparency = 1
                                    nameLbl.Font = Enum.Font.GothamBold
                                    nameLbl.TextSize = 10
                                    nameLbl.TextColor3 = Color3.fromRGB(255, 90, 90)
                                    nameLbl.TextStrokeTransparency = 0.2
                                    nameLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                                    nameLbl.TextYAlignment = Enum.TextYAlignment.Center

                                    data = { bb = bb, nameLbl = nameLbl }
                                    espCache[mob] = data
                                end
                                data.nameLbl.Text = string.format("%s\n[%dst]", safeXml(mob.Name), math.floor(dist))
                            else
                                cleanESP(mob)
                            end
                        else
                            cleanESP(mob)
                        end
                    end
                end
            end
        else
            local npcFolder = workspace:FindFirstChild("Enemies")
            if npcFolder then
                for _, mob in ipairs(npcFolder:GetChildren()) do
                    if espCache[mob] then cleanESP(mob) end
                end
            end
        end
    end

    -- Throttled update loop (0.22s, smooth, zero idle lag)
    task.spawn(function()
        while task.wait(0.22) do
            local anyTextActive = E.Names or E.Fruit or E.Bounty or E.Health or E.Distance or E.Weapons
            local anyPlayerActive = anyTextActive or E.Boxes or E.Chams
            local anyActive = anyPlayerActive or E.Npc
            if anyActive then
                pcall(updateWorldESP)
            elseif next(espCache) ~= nil then
                cleanAllESP()
            end
        end
    end)

    connect(Players.PlayerRemoving, function(plr) cleanESP(plr) end)

    -- LEFT CARD: Individual Player ESP Text Elements
    local tgtCard = createCard(TabEsp, "Left", "Player ESP (Vibrant Text)", ICONS.Visuals)

    addToggle(tgtCard, "Name & Level ESP", {
        Default = false,
        Desc = "Shows player name in team color and gold level",
        Callback = function(v) E.Names = v; pcall(updateWorldESP) end
    })
    addToggle(tgtCard, "Fruit ESP", {
        Default = false,
        Desc = "Shows equipped Devil Fruit in purple",
        Callback = function(v) E.Fruit = v; pcall(updateWorldESP) end
    })
    addToggle(tgtCard, "Bounty ESP", {
        Default = false,
        Desc = "Shows current bounty in orange",
        Callback = function(v) E.Bounty = v; pcall(updateWorldESP) end
    })
    addToggle(tgtCard, "Health ESP", {
        Default = false,
        Desc = "Shows HP percentage (Green / Yellow / Red)",
        Callback = function(v) E.Health = v; pcall(updateWorldESP) end
    })
    addToggle(tgtCard, "Distance ESP", {
        Default = false,
        Desc = "Shows distance in studs in cyan",
        Callback = function(v) E.Distance = v; pcall(updateWorldESP) end
    })
    addToggle(tgtCard, "Weapon ESP", {
        Default = false,
        Desc = "Shows equipped weapon name",
        Callback = function(v) E.Weapons = v; pcall(updateWorldESP) end
    })
    addSlider(tgtCard, "Max Distance", {
        Min = 50, Max = 3000, Default = 1500, Suffix = " st",
        Callback = function(v) E.MaxDistance = v end
    })

    -- RIGHT CARD: Visual Elements & NPCs
    local elemCard = createCard(TabEsp, "Right", "Visual Elements & Targets", ICONS.Sparkles)
    addToggle(elemCard, "Box ESP", {
        Default = false,
        Desc = "2D Bounding Box with health bar",
        Callback = function(v)
            E.Boxes = v
            for _, data in pairs(espCache) do
                if data.boxFrame then data.boxFrame.Visible = v end
                if data.hpBg then data.hpBg.Visible = v end
            end
            pcall(updateWorldESP)
        end
    })
    addDropdown(elemCard, "Box Style", {
        Options = {"2D Box", "Corner Box"},
        Default = "2D Box",
        Callback = function(v) E.BoxStyle = v end
    })
    addToggle(elemCard, "Chams ESP", {
        Default = false,
        Desc = "Player Highlight shader",
        Callback = function(v)
            E.Chams = v
            for _, data in pairs(espCache) do
                if data.hl then data.hl.Enabled = v end
            end
            pcall(updateWorldESP)
        end
    })
    addToggle(elemCard, "NPC ESP", {
        Default = false,
        Desc = "Shows hostile NPC enemies",
        Callback = function(v)
            E.Npc = v
            if not v then
                local npcFolder = workspace:FindFirstChild("Enemies")
                if npcFolder then
                    for _, mob in ipairs(npcFolder:GetChildren()) do cleanESP(mob) end
                end
            else
                pcall(updateWorldESP)
            end
        end
