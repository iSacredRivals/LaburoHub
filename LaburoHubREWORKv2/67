        end
        local ok, isAlly = pcall(function()
            local alliesFolder = ReplicatedStorage:FindFirstChild("Allies") or ReplicatedStorage:FindFirstChild("Alliances")
            if alliesFolder then
                local myId = tostring(LocalPlayer.UserId)
                local targetId = tostring(targetPlayer.UserId)
                for _, folder in ipairs(alliesFolder:GetChildren()) do
                    if folder:FindFirstChild(myId) and folder:FindFirstChild(targetId) then
                        return true
                    end
                end
            end
            return false
        end)
        return ok and isAlly == true
    end

    local function isEnemy(targetPlayer)
        if not targetPlayer or targetPlayer == LocalPlayer then return false end
        if isBloxFruitsAlly(targetPlayer) then return false end
        local myTeam, targetTeam = LocalPlayer.Team, targetPlayer.Team
        if myTeam and targetTeam and myTeam.Name == "Marines" and targetTeam.Name == "Marines" then
            return false
        end
        return true
    end

    -- 4. Blox Fruits Safe Zone Check (Authentic dynamic check)
    local function isInSafeZone(modelOrPlayer)
        if not modelOrPlayer then return false end
        local ok, inZone = pcall(function()
            local isPlr = typeof(modelOrPlayer) == "Instance" and modelOrPlayer:IsA("Player")
            local plr = isPlr and modelOrPlayer or Players:GetPlayerFromCharacter(modelOrPlayer)
            local char = (isPlr and modelOrPlayer.Character) or modelOrPlayer
            if not char then return false end

            if plr and plr:GetAttribute("PvpDisabled") == true then return true end
            if char:GetAttribute("PvpDisabled") == true then return true end

            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Sit == true then return true end
            if char:FindFirstChildOfClass("ForceField") then return true end
            if char:GetAttribute("SafeZone") == true or char:GetAttribute("InSafeZone") == true then return true end
            if plr and (plr:GetAttribute("SafeZone") == true or plr:GetAttribute("InSafeZone") == true) then return true end

            local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            if not hrp then return false end

            local wo = workspace:FindFirstChild("_WorldOrigin")
            local sz = (wo and wo:FindFirstChild("SafeZones")) or workspace:FindFirstChild("SafeZones")
            if sz then
                for _, zone in ipairs(sz:GetChildren()) do
                    if zone:IsA("BasePart") then
                        local mesh = zone:FindFirstChild("Mesh")
                        local radius = 350
                        if mesh and mesh:IsA("SpecialMesh") then
                            radius = (zone.Size.X * mesh.Scale.X) / 2
                        else
                            radius = math.min(zone.Size.X, zone.Size.Z) / 2
                        end
                        if radius > 500 or radius <= 0 then radius = 350 end
                        if (zone.Position - hrp.Position).Magnitude <= radius then
                            return true
                        end
                    end
                end
            end
            return false
        end)
        return ok and inZone == true
    end

    -- Optional PvP Disabled check (only triggers if player has spawn shield or PvpDisabled attribute)
    local function isPvpDisabled(plr)
        if not plr then return false end
        if plr:GetAttribute("PvpDisabled") == true then return true end
        local c = plr.Character
        if c then
            if c:GetAttribute("PvpDisabled") == true then return true end
            if c:FindFirstChildOfClass("ForceField") then return true end
        end
        return false
    end

    -- 5. Level Check Cache
    local playerLevelCache = {}
    local function getPlayerLevel(plr)
        if not plr then return 0 end
        local now = os.clock()
        local uId = plr.UserId or plr.Name
        local cached = playerLevelCache[uId]
        if cached and (now - cached.time < 15) and cached.lvl > 0 then
            return cached.lvl
        end

        local lvl = 0
        local d = plr:FindFirstChild("Data")
        if d and d:FindFirstChild("Level") then
            lvl = tonumber(d.Level.Value) or 0
        end
        if lvl <= 0 then
            local pd = plr:FindFirstChild("PlayerData")
            if pd and pd:FindFirstChild("Level") then
                lvl = tonumber(pd.Level.Value) or 0
            end
        end
        if lvl <= 0 then
            local ls = plr:FindFirstChild("leaderstats")
            local lStat = ls and (ls:FindFirstChild("Level") or ls:FindFirstChild("Lvl"))
            if lStat then lvl = tonumber(lStat.Value) or 0 end
        end
        if lvl <= 0 and plr.Character then
            local aLvl = plr.Character:GetAttribute("Level") or plr:GetAttribute("Level")
            if aLvl and tonumber(aLvl) and tonumber(aLvl) > 0 then
                lvl = tonumber(aLvl)
            end
        end

        playerLevelCache[uId] = { lvl = lvl, time = now }
        return lvl
    end

    -- 6. Target Validity Rules
    local function isValidPlayerTarget(plr, myHrp)
        if not plr or plr == LocalPlayer or not plr.Character then return false end
        if _G.PlayerBlacklist then
            if _G.PlayerBlacklist[plr.UserId] or _G.PlayerBlacklist[tostring(plr.UserId)]
                or _G.PlayerBlacklist[plr.Name] or _G.PlayerBlacklist[string.lower(plr.Name)]
                or _G.PlayerBlacklist[plr.DisplayName] or _G.PlayerBlacklist[string.lower(plr.DisplayName)] then
                return false
            end
        end
        local char = plr.Character
        if not char:IsDescendantOf(workspace) then return false end

        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = getTargetPart(char, "HumanoidRootPart")
        if not hum or hum.Health <= 0 or not root or root.Position.Y <= -500 then return false end

        if BF_Combat.IgnorePvpOff and isPvpDisabled(plr) then return false end
        if BF_Combat.SafeZoneCheck and isInSafeZone(plr) then return false end
        if BF_Combat.TeamCheck and not isEnemy(plr) then return false end

        if BF_Combat.IgnoreLowLevel then
            local lvl = getPlayerLevel(plr)
            if lvl > 0 and lvl < (BF_Combat.MinLevel or 2000) then return false end
        end

        local dist = (root.Position - myHrp.Position).Magnitude
        if dist > 1200 then return false end

        return true, dist, char
    end

    local function isValidNpcTarget(npc, myHrp)
        if not npc or not npc:IsDescendantOf(workspace) or not npc:IsA("Model") then return false end
        if Players:GetPlayerFromCharacter(npc) then return false end

        -- Blox Fruits Quest / Shop / Non-combat NPC Filter
        local name = string.lower(npc.Name)
        if name:find("quest") or name:find("dealer") or name:find("shop") or name:find("citizen")
            or name:find("trainer") or name:find("agent") or name:find("scientist") or name:find("manager")
            or name:find("set home") or name:find("pirate starter") or name:find("marine starter")
            or name:find("fruit") or name:find("boat") or name:find("luxury") or name:find("gacha")
            or name:find("rei") or name:find("bartilo") or name:find("alchemist") or name:find("cyborg")
            or name:find("tomb") or name:find("crew") or name:find("swapper") or name:find("cousin")
            or name:find("tortoise") or name:find("nerd") or name:find("capp") or name:find("dummy")
            or name:find("dialog") or name:find("talk") or name:find("interaction") then
            return false
        end

        if npc:FindFirstChild("Dialogue") or npc:FindFirstChild("Dialog") or npc:FindFirstChild("Quest")
            or npc:FindFirstChild("QuestGiver") or npc:FindFirstChild("Talk") or npc:FindFirstChild("Interaction")
            or npc:FindFirstChildWhichIsA("ClickDetector", true) or npc:FindFirstChild("Prompt", true) then
            return false
        end

        local hrp = npc:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.Anchored then
            return false -- Quest NPCs are anchored, hostile mobs are unanchored!
        end

        local hum = npc:FindFirstChildOfClass("Humanoid")
        local root = getTargetPart(npc, "HumanoidRootPart")
        if not hum or hum.Health <= 0 or hum.MaxHealth <= 100 or not root or root.Position.Y <= -500 then
            return false
        end

        if BF_Combat.SafeZoneCheck and isInSafeZone(npc) then return false end

        local dist = (root.Position - myHrp.Position).Magnitude
        if dist > 800 then return false end

        return true, dist, npc
    end

    local function getBestCombatTarget()
        local myChar = LocalPlayer.Character
        local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)
        if not myHrp then return nil, nil end

        local bestTarget, bestPart, bestScore = nil, nil, math.huge

        local function checkCandidate(entity, isPlayer)
            local valid, dist, char
            if isPlayer then
                valid, dist, char = isValidPlayerTarget(entity, myHrp)
            else
                valid, dist, char = isValidNpcTarget(entity, myHrp)
            end
            if not valid then return end

            local part = getTargetPart(char, BF_Combat.TargetPart)
            if not part then return end

            local score = getAimScore(part, dist)
            if score and score < bestScore then
                bestScore = score
                bestTarget = entity
                bestPart = part
            end
        end

        -- 1. Check Enemy Players First
        if BF_Combat.AimPlayers then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    checkCandidate(plr, true)
                end
            end
        end

        -- If a valid player target was found, prioritize the player!
        if bestTarget and (bestTarget:IsA("Player") or (typeof(bestTarget) == "Instance" and bestTarget:IsA("Model") and Players:GetPlayerFromCharacter(bestTarget))) then
