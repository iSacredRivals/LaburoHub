    local v4Cooldown = 0
    local function triggerV4()
        local char = LocalPlayer.Character
        if not char then return end

        local energy = char:FindFirstChild("RaceEnergy") or char:GetAttribute("RaceEnergy")
        local transformed = char:FindFirstChild("RaceTransformed") or char:GetAttribute("RaceTransformed") or char:GetAttribute("Awakened")
        local stun = char:FindFirstChild("Stun")
        local busy = char:FindFirstChild("Busy")

        local hasEnergy = false
        if typeof(energy) == "Instance" and energy:IsA("ValueBase") then
            hasEnergy = tonumber(energy.Value) and tonumber(energy.Value) >= 1
        elseif type(energy) == "number" then
            hasEnergy = energy >= 1
        end

        local isTransformed = false
        if typeof(transformed) == "Instance" and transformed:IsA("ValueBase") then
            isTransformed = (transformed.Value == true)
        elseif transformed == true then
            isTransformed = true
        end

        local isStunned = (typeof(stun) == "Instance" and (tonumber(stun.Value) or 0) > 0)
        local isBusy = (typeof(busy) == "Instance" and busy.Value == true)

        if hasEnergy and not isTransformed and not isStunned and not isBusy then
            if tick() - v4Cooldown < 2.0 then return end
            v4Cooldown = tick()

            pcall(function()
                local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
                local commE = remotes and remotes:FindFirstChild("CommE")
                if commE then commE:FireServer("ActivateAwakening", true) end

                local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
                local awk = (bp and bp:FindFirstChild("Awakening")) or (char and char:FindFirstChild("Awakening"))
                if awk then
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if awk.Parent == bp and hum then
                        pcall(function() hum:EquipTool(awk) end)
                    end
                    pcall(function() awk:Activate() end)
                    local rf = awk:FindFirstChild("RemoteFunction")
                    if rf and rf:IsA("RemoteFunction") then pcall(function() rf:InvokeServer(true) end) end
                    local re = awk:FindFirstChild("RemoteEvent")
                    if re and re:IsA("RemoteEvent") then pcall(function() re:FireServer(true) end) end
                end

                local ev = game:GetService("ReplicatedStorage"):FindFirstChild("Events")
                local actV4 = ev and ev:FindFirstChild("ActivateRaceV4")
                if actV4 and actV4:IsA("BindableEvent") then
                    pcall(function() actV4:Fire() end)
                end
            end)
        end
    end

