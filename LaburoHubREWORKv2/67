    local function applyCustomLayoutToWidget(obj, key)
        local layout = _G.AuroraX_Layout or loadStoredHUDLayout()
        if not layout or not layout[key] then return end
        local data = layout[key]
        pcall(function()
            -- Disable restrictive parent layouts and clipping
            local curr = obj.Parent
            while curr and curr:IsA("GuiObject") do
                curr.ClipsDescendants = false
                for _, l in ipairs(curr:GetChildren()) do
                    if l:IsA("UIListLayout") or l:IsA("UIGridLayout") or l:IsA("UITableLayout") then
                        l.Enabled = false
                    end
                end
                curr = curr.Parent
            end

            obj.Position = UDim2.new(data.ScaleX or 0, data.OffsetX or 0, data.ScaleY or 0, data.OffsetY or 0)
            if data.SizeScale then
                local s = obj:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", obj)
                s.Scale = data.SizeScale
            end
        end)
    end

    local function saveAllLayoutPositions()
        local layout = loadStoredHUDLayout() or {}
        local widgets = getDraggableHUDWidgets()
        for _, w in ipairs(widgets) do
            local obj = w.Object
            local s = obj:FindFirstChildOfClass("UIScale")
            layout[w.Key] = {
                ScaleX = obj.Position.X.Scale,
                OffsetX = obj.Position.X.Offset,
                ScaleY = obj.Position.Y.Scale,
                OffsetY = obj.Position.Y.Offset,
                SizeScale = s and s.Scale or 1,
            }
        end
        _G.AuroraX_Layout = layout

        if writefile then
            pcall(function()
                if not isfolder or not isfolder("AuroraX") then
                    if makefolder then pcall(makefolder, "AuroraX") end
                end
                writefile("AuroraX/hud_layout.json", HttpService:JSONEncode(layout))
            end)
        end

        pcall(function()
            local rem = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
            local changeSetting = rem and rem:FindFirstChild("ChangeSetting")
            if changeSetting then
                for _, w in ipairs(widgets) do
                    if w.Key:find("BoundAction") or w.Key:find("Skill_") or w.Key:find("Race") then
                        changeSetting:FireServer("MobileButtonCustomization", {
                            Prop = "Position",
                            ButtonName = w.Key,
                            Value = {
                                X = math.round(w.Object.Position.X.Scale * 1000) / 1000,
                                Y = math.round(w.Object.Position.Y.Scale * 1000) / 1000
                            }
                        })
                    end
                end
            end
        end)

        notify("HUD Studio", "HUD layout saved successfully to disk!", 2.5)
    end

    local function resetAllLayoutPositions()
        local widgets = getDraggableHUDWidgets()
        for _, w in ipairs(widgets) do
            local def = defaultHUDLayout[w.Key]
            if def then
                w.Object.Position = def.Position
                local s = w.Object:FindFirstChildOfClass("UIScale")
                if s then s.Scale = def.Scale or 1 end
            end

            -- Re-enable layouts
            local curr = w.Object.Parent
            while curr and curr:IsA("GuiObject") do
                for _, l in ipairs(curr:GetChildren()) do
                    if l:IsA("UIListLayout") or l:IsA("UIGridLayout") or l:IsA("UITableLayout") then
                        l.Enabled = true
                    end
                end
                curr = curr.Parent
            end
        end

        pcall(function()
            local rem = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
            local changeSetting = rem and rem:FindFirstChild("ChangeSetting")
            if changeSetting then
                changeSetting:FireServer("MobileButtonCustomization", {Prop = "Reset"})
            end
        end)

        _G.AuroraX_Layout = {}
        if writefile then
            pcall(function() writefile("AuroraX/hud_layout.json", "{}") end)
        end

        notify("HUD Studio", "HUD layout reset to original defaults!", 2.5)
