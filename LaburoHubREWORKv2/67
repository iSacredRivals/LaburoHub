                    twHpBar.Size = UDim2.fromScale(pct, 1)
                    twHpBar.BackgroundColor3 = Color3.fromHSV(pct * 0.33, 0.9, 0.95)
                end
                if dist ~= twLastDist or pct ~= twLastHpPct then
                    twLastDist = dist
                    twInfo.Text = string.format("Dist: %d st  |  Health: %d%%", dist, math.floor(pct * 100))
                end
            end
        else
            if not twIdle then
                twIdle = true
                twLastTarget = nil
                twLastHpPct = -1
                twLastDist = -1
                twName.Text = "No Target Locked"
                twAvatar.Image = LOGO_ID
                twAvatar.ImageColor3 = THEME.Accent
                twHpBar.Size = UDim2.fromScale(1, 1)
                twHpBar.BackgroundColor3 = Color3.fromRGB(50, 42, 58)
