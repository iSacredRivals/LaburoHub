    local function GetFruitRemote()
        local char = LocalPlayer.Character
        if not char then return nil end

        local fruit = nil
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and (item:GetAttribute("WeaponType") == "Demon Fruit" or item.ToolTip == "Blox Fruit") then
                fruit = item
                break
            end
        end

        if not fruit then
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if backpack then
                for _, item in ipairs(backpack:GetChildren()) do
                    if item:IsA("Tool") and (item:GetAttribute("WeaponType") == "Demon Fruit" or item.ToolTip == "Blox Fruit") then
                        fruit = item
                        break
                    end
                end
                if fruit then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum:EquipTool(fruit)
                        task.wait(0.08)
                        for _, item in ipairs(char:GetChildren()) do
                            if item:IsA("Tool") and (item:GetAttribute("WeaponType") == "Demon Fruit" or item.ToolTip == "Blox Fruit") then
                                fruit = item
                                break
                            end
                        end
                    end
                end
            end
        end

        if not fruit then return nil end

        local remote = fruit:FindFirstChild("LeftClickRemote")
            or fruit:FindFirstChild("ClickRemote")
            or fruit:FindFirstChild("M1Remote")

        if not remote then
            for _, v in ipairs(fruit:GetChildren()) do
                if v:IsA("RemoteEvent") and string.find(string.lower(v.Name), "click") then
                    remote = v
                    break
                end
            end
        end

        return remote
    end

