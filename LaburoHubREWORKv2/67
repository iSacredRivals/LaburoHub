    local function resetAllActiveSkins()
        for _, c in ipairs(CATEGORIES) do
            if categoryListeners[c] then
                pcall(function() categoryListeners[c]:Disconnect() end)
                categoryListeners[c] = nil
            end
            if cachedCategoryImages[c] then
                for img, orig in pairs(cachedCategoryImages[c]) do
                    if img and img.Parent then
                        pcall(function()
                            img.Image = orig.Image
                            img.ImageColor3 = orig.ImageColor3 or Color3.fromRGB(255, 255, 255)
                            img.ImageRectOffset = orig.ImageRectOffset
                            img.ImageRectSize = orig.ImageRectSize
                            img.ScaleType = orig.ScaleType
                        end)
                    end
                end
                cachedCategoryImages[c] = {}
            end
            equippedSkins[c] = nil
        end

        pcall(function()
            local char = LocalPlayer.Character
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
            local tools = {}
            if char then
                for _, c in ipairs(char:GetChildren()) do
                    if c:IsA("Tool") then table.insert(tools, c) end
                end
            end
            if bp then
                for _, c in ipairs(bp:GetChildren()) do
