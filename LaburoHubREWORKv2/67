-- =============================================================================
-- MODULE 6: COLORS (AURORA X VFX ENGINE + RULETA + PRESETS WITHOUT RAINBOW)
-- =============================================================================
local function initColors()
    _G.auroraxcolors = _G.auroraxcolors or {}
    local VFX = _G.auroraxcolors

    VFX.Settings = {
        Enabled = false,
        Preset = "Purple",
        CustomAccent = Color3.fromRGB(165, 75, 230),
        GradientStyle = "Black to Color to Black",
        AffectSkills = false,
        AffectSwords = false,
        AffectTransform = false,
        AffectEnvironment = false,
    }
    local S = VFX.Settings

    local VFXPresets = {
        ["Purple"]        = Color3.fromRGB(165, 75, 230),
        ["Red"]           = Color3.fromRGB(220, 50, 50),
        ["Blue"]          = Color3.fromRGB(65, 145, 255),
        ["Cyan"]          = Color3.fromRGB(55, 210, 225),
        ["Green"]         = Color3.fromRGB(50, 190, 100),
        ["Gold"]          = Color3.fromRGB(238, 190, 40),
        ["Pink"]          = Color3.fromRGB(235, 85, 150),
        ["Magenta"]       = Color3.fromRGB(190, 0, 205),
        ["White"]         = Color3.fromRGB(245, 245, 248),
        ["Black"]         = Color3.fromRGB(20, 20, 20),
        ["Midnight"]      = Color3.fromRGB(10, 12, 24),
        ["Violet"]        = Color3.fromRGB(220, 50, 230),
        ["Lime"]          = Color3.fromRGB(80, 255, 60),
        ["Orange"]        = Color3.fromRGB(255, 120, 20),
        ["Silver"]        = Color3.fromRGB(215, 225, 245),
        ["Crimson"]       = Color3.fromRGB(220, 15, 45),
        ["Black & White"] = Color3.fromRGB(255, 255, 255),
        ["Yellow"]        = Color3.fromRGB(255, 235, 30),
        ["Teal"]          = Color3.fromRGB(0, 210, 190),
        ["Ice Blue"]      = Color3.fromRGB(160, 225, 255),
        ["Custom Color"]  = Color3.fromRGB(165, 75, 230),
    }

    local function getActiveColor()
        if S.Preset == "Custom Color" then
            return S.CustomAccent
        end
        return VFXPresets[S.Preset] or S.CustomAccent
    end

    local function blendColor(baseColor, targetColor)
        if typeof(baseColor) ~= "Color3" then return targetColor end
        if targetColor.R > 0.92 and targetColor.G > 0.92 and targetColor.B > 0.92 then
            return Color3.fromRGB(255, 255, 255)
        end
        local h, s, v = targetColor:ToHSV()
        local lum = math.clamp(baseColor.R * 0.2126 + baseColor.G * 0.7152 + baseColor.B * 0.0722, 0, 1)
        local val = math.clamp(v * (0.35 + 0.65 * math.sqrt(lum)), 0.25, 1)
        local recolored = Color3.fromHSV(h, s, val)
        return baseColor:Lerp(recolored, 1.0)
    end

    local function blendColorSequence(origSeq, targetColor)
        if typeof(origSeq) ~= "ColorSequence" then return ColorSequence.new(targetColor) end
        if targetColor.R > 0.92 and targetColor.G > 0.92 and targetColor.B > 0.92 then
            return ColorSequence.new(Color3.fromRGB(255, 255, 255))
        end
        local keypoints = {}
        for _, kp in ipairs(origSeq.Keypoints) do
            table.insert(keypoints, ColorSequenceKeypoint.new(kp.Time, blendColor(kp.Value, targetColor)))
        end
        return ColorSequence.new(keypoints)
    end

    local originals = setmetatable({}, { __mode = "k" })

    local function recordOriginal(inst, prop)
        local tbl = originals[inst]
        if not tbl then tbl = {}; originals[inst] = tbl end
        if tbl[prop] == nil then
            local ok, val = pcall(function() return inst[prop] end)
            if ok and val ~= nil then tbl[prop] = val end
        end
    end

    local function resetOriginalVFX()
        for inst, props in pairs(originals) do
            if inst and inst.Parent then
                for prop, val in pairs(props) do
                    pcall(function() inst[prop] = val end)
                end
            end
        end
        originals = setmetatable({}, { __mode = "k" })
    end

    local function applyVisualColor(inst, targetColor)
        if not S.Enabled or not inst then return end
        targetColor = targetColor or getActiveColor()
        local isWhite = (targetColor.R > 0.92 and targetColor.G > 0.92 and targetColor.B > 0.92)

        pcall(function()
            if inst:IsA("ParticleEmitter") then
                if not S.AffectSkills then return end
                recordOriginal(inst, "Color")
                recordOriginal(inst, "LightEmission")
                local orig = (originals[inst] and originals[inst].Color) or inst.Color
                inst.Color = blendColorSequence(orig, targetColor)
                if isWhite then inst.LightEmission = 1 end
            elseif inst:IsA("Beam") or inst:IsA("Trail") then
                if not S.AffectSkills then return end
                recordOriginal(inst, "Color")
                recordOriginal(inst, "LightEmission")
                local orig = (originals[inst] and originals[inst].Color) or inst.Color
                inst.Color = blendColorSequence(orig, targetColor)
                if isWhite then inst.LightEmission = 1 end
            elseif inst:IsA("Highlight") then
                if not S.AffectTransform then return end
                recordOriginal(inst, "FillColor")
                recordOriginal(inst, "OutlineColor")
                inst.FillColor = targetColor
                inst.OutlineColor = isWhite and Color3.fromRGB(255, 255, 255) or blendColor(Color3.fromRGB(255, 255, 255), targetColor)
            elseif inst:IsA("Light") then
                if not S.AffectSkills then return end
                recordOriginal(inst, "Color")
                inst.Color = targetColor
            elseif inst:IsA("Decal") or inst:IsA("Texture") then
                if not S.AffectSkills then return end
                recordOriginal(inst, "Color3")
                inst.Color3 = targetColor
            elseif inst:IsA("SpecialMesh") then
                if not S.AffectSwords then return end
                recordOriginal(inst, "VertexColor")
                inst.VertexColor = Vector3.new(targetColor.R, targetColor.G, targetColor.B)
            end
        end)
    end

    local function scanAndApply(root, targetColor)
        if not root then return end
        applyVisualColor(root, targetColor)
        local descs = root:GetDescendants()
        for i = 1, #descs do
            applyVisualColor(descs[i], targetColor)
            if i % 250 == 0 then
                task.wait()
            end
        end
    end

    local function refreshAllVFX()
        task.spawn(function()
            if not S.Enabled then return end
            local col = getActiveColor()
            for inst, _ in pairs(originals) do
                if inst and inst.Parent then applyVisualColor(inst, col) end
            end
            local myChar = LocalPlayer.Character
            if myChar then scanAndApply(myChar, col) end
            local wo = workspace:FindFirstChild("_WorldOrigin")
            if wo and (S.AffectEnvironment or S.AffectSkills or S.AffectSwords) then scanAndApply(wo, col) end
            local fx = workspace:FindFirstChild("Effects") or workspace:FindFirstChild("FX")
            if fx and S.AffectSkills then scanAndApply(fx, col) end
        end)
    end

    local vfxConnections = {}
    local function stopVFXWatchers()
        for _, conn in ipairs(vfxConnections) do pcall(function() conn:Disconnect() end) end
        table.clear(vfxConnections)
    end

    local function startVFXWatchers()
        stopVFXWatchers()
        local function bindWorld(wo)
            if not wo then return end
            table.insert(vfxConnections, wo.DescendantAdded:Connect(function(child)
                if S.Enabled and (S.AffectEnvironment or S.AffectSkills or S.AffectSwords) then
                    task.defer(applyVisualColor, child)
                end
            end))
        end
        local function bindChar(char)
            if not char then return end
            table.insert(vfxConnections, char.DescendantAdded:Connect(function(child)
                if S.Enabled then task.defer(applyVisualColor, child) end
            end))
        end

        local wo = workspace:FindFirstChild("_WorldOrigin")
        if wo then bindWorld(wo) end
        table.insert(vfxConnections, workspace.ChildAdded:Connect(function(child)
            if child.Name == "_WorldOrigin" then
                bindWorld(child)
                if S.Enabled and (S.AffectEnvironment or S.AffectSkills or S.AffectSwords) then scanAndApply(child) end
            end
        end))

        local char = LocalPlayer.Character
        if char then bindChar(char) end
        table.insert(vfxConnections, LocalPlayer.CharacterAdded:Connect(function(newChar)
            bindChar(newChar)
            if S.Enabled then task.delay(0.2, function() scanAndApply(newChar) end) end
        end))

        local fx = workspace:FindFirstChild("Effects") or workspace:FindFirstChild("FX")
        if fx then
            table.insert(vfxConnections, fx.DescendantAdded:Connect(function(child)
                if S.Enabled and S.AffectSkills then task.defer(applyVisualColor, child) end
            end))
        end
    end

    VFX.Refresh = refreshAllVFX
    VFX.Reset = resetOriginalVFX

    -- UI CARDS
    -- Card 1: Master VFX
    local sc1 = createCard(TabColors, "Left", "Aurora VFX Engine", ICONS.Colors)
    local vfxSkillsToggle = nil
    local vfxSwordsToggle = nil
    local vfxTransformToggle = nil
    local vfxEnvToggle = nil

    local vfxMasterToggle = addToggle(sc1, "Aurora VFX", {
        Default = false,
        Desc = "Master switch to recolor Blox Fruits combat particles",
        Callback = function(v)
            S.Enabled = v
            if v then
                if vfxSkillsToggle then vfxSkillsToggle.Set(true) else S.AffectSkills = true end
                if vfxSwordsToggle then vfxSwordsToggle.Set(true) else S.AffectSwords = true end
                if vfxTransformToggle then vfxTransformToggle.Set(true) else S.AffectTransform = true end
                if vfxEnvToggle then vfxEnvToggle.Set(true) else S.AffectEnvironment = true end
                startVFXWatchers()
                refreshAllVFX()
                notify("VFX Engine", "Aurora VFX ENABLED", 2)
            else
                resetOriginalVFX()
                stopVFXWatchers()
                notify("VFX Engine", "Aurora VFX DISABLED", 2)
            end
        end
    })

    addButton(sc1, "Reset Original", {
        Icon = ICONS.Reset,
        Callback = function()
            S.Enabled = false
            if vfxMasterToggle then vfxMasterToggle.Set(false) end
            if vfxSkillsToggle then vfxSkillsToggle.Set(false) end
            if vfxSwordsToggle then vfxSwordsToggle.Set(false) end
            if vfxTransformToggle then vfxTransformToggle.Set(false) end
            if vfxEnvToggle then vfxEnvToggle.Set(false) end
            resetOriginalVFX()
            stopVFXWatchers()
            notify("VFX Engine", "VFX Restablecido al Original", 2)
        end
    })

    vfxSkillsToggle = addToggle(sc1, "Affect Skills", {
        Default = false,
        Desc = "Recolors fruit and fighting style particle emitters",
        Callback = function(v) S.AffectSkills = v; if S.Enabled then refreshAllVFX() end end
    })

