    -- Network Metatable Hook: __namecall redirection (from RJR.lua)
    pcall(function()
        local mt = getrawmetatable and getrawmetatable(game)
        if mt then
            local oldNamecall = mt.__namecall
            if setreadonly then setreadonly(mt, false) end
            local function silentNamecall(self, ...)
                local method = (getnamecallmethod and getnamecallmethod()) or ""
                local args = {...}

                -- Aurora X Blox Fruits Gun Shooting Redirection
                if method == "FireServer" and tostring(self) == "ShootGunEvent" then
                    if _G.G_SilentAimTargetPos then
                        args[1] = _G.G_SilentAimTargetPos
                        return oldNamecall(self, unpack(args))
                    end
                end

                -- Aurora X RegisterHit Redirection
                if method == "FireServer" and (tostring(self) == "RegisterHit" or tostring(self) == "RegisterAttack") then
                    if _G.G_SilentAimTargetPart and _G.G_SilentAimTargetPart.Parent then
                        if args[1] and typeof(args[1]) == "Instance" then
                            args[1] = _G.G_SilentAimTargetPart
                        end
                        return oldNamecall(self, unpack(args))
                    end
                end

                -- CommE and RemoteEvent Vector3 Redirection
                if _G.G_SilentAimSkill and _G.G_SilentAimTargetPos and (method == "FireServer" or method == "InvokeServer") then
                    local sName = tostring(self)
                    if sName == "RemoteEvent" or sName == "CommE" or sName == "RemoteFunction" or self.Name == "CommE" then
                        for i, v in ipairs(args) do
                            if typeof(v) == "Vector3" then
                                args[i] = _G.G_SilentAimTargetPos
                            end
                        end
                        return oldNamecall(self, unpack(args))
                    end
                end

                return oldNamecall(self, ...)
            end
            if newcclosure then
                mt.__namecall = newcclosure(silentNamecall)
            else
                mt.__namecall = silentNamecall
            end
            if setreadonly then setreadonly(mt, true) end
        end
    end)

    -- MouseModule hook (ReplicatedStorage.Mouse: Hit and Target redirection) (from RJR.lua)
    pcall(function()
        local MouseModuleInstance = game:GetService("ReplicatedStorage"):FindFirstChild("Mouse")
        if MouseModuleInstance then
            local ok, mm = pcall(require, MouseModuleInstance)
            if ok and type(mm) == "table" then
                local realStore = { Hit = rawget(mm, "Hit"), Target = rawget(mm, "Target") }
                local mmt = (getrawmetatable and getrawmetatable(mm)) or {}
                if setreadonly and getrawmetatable then setreadonly(mmt, false) end
                setmetatable(mm, mmt)
                rawset(mm, "Hit", nil)
                rawset(mm, "Target", nil)
                mmt.__index = function(self, key)
                    if key == "Hit" then
                        if _G.G_SilentAimSkill and _G.G_SilentAimTargetPos then
                            return CFrame.new(_G.G_SilentAimTargetPos)
                        end
                        return realStore.Hit
                    elseif key == "Target" then
                        if _G.G_SilentAimSkill and _G.G_SilentAimTargetPart then
                            return _G.G_SilentAimTargetPart
                        end
                        return realStore.Target
                    end
                    return rawget(self, key)
                end
                mmt.__newindex = function(self, key, value)
                    if key == "Hit" or key == "Target" then
                        realStore[key] = value
                    else
                        rawset(self, key, value)
                    end
                end
                if setreadonly and getrawmetatable then setreadonly(mmt, true) end
            end
        end
    end)

    -- LocalPlayer:GetMouse() __index hook (from RJR.lua)
    pcall(function()
        local mouse = LocalPlayer:GetMouse()
        if hookmetamethod then
            local oldIndex
            oldIndex = hookmetamethod(game, "__index", function(self, key)
