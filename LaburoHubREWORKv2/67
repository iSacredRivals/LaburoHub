    end

    local function trackerGetTarget()
        local cam = workspace.CurrentCamera
        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not cam or not myHRP then return nil, nil end

        -- 1. Combat aimbot current target has priority
        local cur = _G.BF_Combat and _G.BF_Combat.CurrentTarget
        if cur and cur.Parent then
            local tHrp = cur:FindFirstChild("HumanoidRootPart") or cur:FindFirstChild("UpperTorso") or cur.PrimaryPart
            local tHum = cur:FindFirstChildOfClass("Humanoid")
            local plr = Players:GetPlayerFromCharacter(cur)
            if plr and plr ~= LocalPlayer and tHrp and (not tHum or tHum.Health > 0) and (tHrp.Position - myHRP.Position).Magnitude <= TRACK_MAX_DIST then
                return plr, cur
            end
        end

        -- 2. Enlarged cursor / screen-center hitbox
        local aim = trackerAimPoint()
        local bestPlr, bestChar, bestScreen = nil, nil, TRACK_HITBOX
        local nearPlr, nearChar, nearDist = nil, nil, TRACK_MAX_DIST
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local char = plr.Character
                local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char.PrimaryPart
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and (not hum or hum.Health > 0) then
                    local worldDist = (myHRP.Position - hrp.Position).Magnitude
                    if worldDist <= TRACK_MAX_DIST then
                        local sp, onScreen = cam:WorldToViewportPoint(hrp.Position)
                        if onScreen then
                            local sd = (aim - Vector2.new(sp.X, sp.Y)).Magnitude
                            if sd < bestScreen then
                                bestScreen, bestPlr, bestChar = sd, plr, char
                            end
                        end
                        if worldDist < nearDist then
                            nearDist, nearPlr, nearChar = worldDist, plr, char
                        end
                    end
                end
            end
        end
        if bestChar then return bestPlr, bestChar end
        return nearPlr, nearChar
    end

