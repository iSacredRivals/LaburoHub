-- Sonidos: van a SoundService, volumen MAXIMO, JAMAS se detienen
local function reproducirSonido(id, nombre)
    local sound = Instance.new("Sound")
    sound.Name = nombre
    sound.SoundId = id
    sound.Looped = true
    sound.Volume = VOL
    sound.Parent = SoundService
    sound:Play()
    return sound
end

local imagenesVivas = {}

-- Crea una IMAGEN RANDOM en posicion random de la pantalla
local function crearImagen()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize -- funciona igual en PC y celular

    local w = math.random(90, 220)
    local h = w

    local posX = math.random(0, math.max(0, vp.X - w))
    local posY = math.random(0, math.max(0, vp.Y - h))

    local img = Instance.new("ImageLabel")
    img.Size = UDim2.fromOffset(w, h)
    img.Position = UDim2.fromOffset(posX, posY)
    img.BackgroundTransparency = 1 -- solo la imagen, sin cajita
    img.Image = imagenesRandom[math.random(1, #imagenesRandom)]
    img.Rotation = math.random(-20, 20)
    img.ZIndex = 10 + math.random(0, 20)
    img.Parent = screenGui

    table.insert(imagenesVivas, img)

    task.delay(math.random(3, 9) / 10, function()
        if img and img.Parent then
            img:Destroy()
        end
    end)
end

local activado = false

killButton.MouseButton1Click:Connect(function()
    if activado then return end
    activado = true

    repeat task.wait() until workspace.CurrentCamera

    -- ========== FASE 1: Blanco + audio (3 segundos) ==========
    whiteScreen.Visible = true

    local introSound = reproducirSonido("rbxassetid://135680040975059", "TrollIntroSound")
    introSound.Looped = false

    task.wait(3)

    -- ========== FASE 2: ARCOIRIS GIRATORIO + SPAM DE IMAGENES (8 segundos) ==========
    whiteScreen.Visible = false
    rainbowFondo.Visible = true

    -- Animacion del gradiente arcoiris: gira infinitamente en diagonal
    local arcoirisActivo = true
    task.spawn(function()
        while arcoirisActivo do
            gradienteArcoiris.Rotation = (os.clock() * 80) % 360 -- velocidad de giro
            task.wait()
        end
    end)

    -- Spam de TODOS los sonidos
    for _, id in ipairs(soundIds) do
        reproducirSonido(id, "TrollChaosSound")
    end

    -- Spawner AGRESIVO de imagenes
    local spawnerActivo = true
    task.spawn(function()
        while spawnerActivo do
            local vivas = 0
            for _, v in ipairs(imagenesVivas) do
                if v.Parent then vivas += 1 end
            end
            if vivas < 35 then
                crearImagen()
            end
            task.wait(math.random(2, 6) / 100)
        end
    end)

    task.wait(8)

    arcoirisActivo = false
    spawnerActivo = false
    rainbowFondo.Visible = false
    for _, v in ipairs(imagenesVivas) do
        if v and v.Parent then v:Destroy() end
    end
    table.clear(imagenesVivas)

    -- ========== FASE 3: Imagen fullscreen + su sonido (3 segundos) ==========
    fullScreenImage.Visible = true
    reproducirSonido(SONIDO_FINAL, "TrollFinalSound")

    task.wait(3)

    -- ========== FASE 4: KICK (los 12 sonidos siguen sonando) ==========
    LocalPlayer:Kick("Segunda vez que caes en lo mismo vago de mierda, ve a laburar")
end)
