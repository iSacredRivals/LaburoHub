local function initPlayerList()
    local isSpectatingPlr = nil
    local searchQuery = ""
    local totalPlayersLabel = nil
    local blacklistedCountLabel = nil
    local spectatingLabel = nil

    local function stopSpectating()
        if isSpectatingPlr then
            local cam = workspace.CurrentCamera
            local myChar = LocalPlayer.Character
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            if cam and myHum then
                cam.CameraSubject = myHum
            end
            isSpectatingPlr = nil
            if spectatingLabel then
                spectatingLabel("None")
            end
        end
    end

    -- LEFT COLUMN: Controls & Overview
    local ctrlCard = createCard(TabPlayerList, "Left", "Player Controls", ICONS.Settings)

    local searchRow = newRow(ctrlCard, "SearchRow", 28)
    local searchBg = create("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = THEME.InputBg,
        BorderSizePixel = 0,
        Parent = searchRow,
    })
    addCorner(searchBg, 6)
    addStroke(searchBg, THEME.Border, 1)

    newIcon(searchBg, ICONS.Search, 12, THEME.TextMuted, {
        Position = UDim2.new(0, 8, 0.5, -6),
    })

    local searchBox = create("TextBox", {
        Position = UDim2.new(0, 26, 0, 0),
        Size = UDim2.new(1, -32, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        TextSize = 10.5,
        TextColor3 = THEME.TextPrimary,
        PlaceholderColor3 = THEME.TextDim,
        PlaceholderText = "Search player username or display...",
        Text = "",
        ClearTextOnFocus = false,
        Parent = searchBg,
    })

    local renderPlayerList -- forward declaration

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        searchQuery = string.lower(searchBox.Text or "")
        if renderPlayerList then renderPlayerList() end
    end)

    addButton(ctrlCard, "Refresh Players", {
        Icon = ICONS.Refresh,
        Callback = function()
            if renderPlayerList then renderPlayerList() end
            notify("Player List", "Refreshed server player list", 1.5)
        end,
    })

    addButton(ctrlCard, "Stop Spectate", {
        Icon = ICONS.User,
        Callback = function()
            stopSpectating()
            if renderPlayerList then renderPlayerList() end
            notify("Spectate", "Camera returned to local character", 1.5)
        end,
    })

    addButton(ctrlCard, "Clear Blacklist", {
        Icon = ICONS.Trash,
        Callback = function()
            _G.PlayerBlacklist = {}
            if renderPlayerList then renderPlayerList() end
            notify("Player List", "Cleared all blacklisted players", 2)
        end,
    })

    local infoCard = createCard(TabPlayerList, "Left", "Blacklist & Info", ICONS.Info)
    totalPlayersLabel = addLabel(infoCard, "Server Players", tostring(#Players:GetPlayers()))
    blacklistedCountLabel = addLabel(infoCard, "Blacklisted Count", "0")
    spectatingLabel = addLabel(infoCard, "Spectating", "None")

    -- RIGHT COLUMN: Server Players List
    local listCard = createCard(TabPlayerList, "Right", "Server Players", ICONS.User)

    renderPlayerList = function()
        if unloaded or not listCard or not listCard.Frame then return end

        local allPlrs = Players:GetPlayers()
        local blCount = 0
        local q = string.lower(searchQuery or "")

        for _, p in ipairs(allPlrs) do
            if _G.PlayerBlacklist and (_G.PlayerBlacklist[p.UserId] or _G.PlayerBlacklist[p.Name]) then
                blCount = blCount + 1
            end
        end

        if totalPlayersLabel then totalPlayersLabel(tostring(#allPlrs)) end
        if blacklistedCountLabel then blacklistedCountLabel(tostring(blCount)) end
        if spectatingLabel then
            spectatingLabel(isSpectatingPlr and isSpectatingPlr.DisplayName or "None")
        end

        for _, child in ipairs(listCard.Frame:GetChildren()) do
            if child:IsA("Frame") and child.Name:match("^PlrCard_") then
                child:Destroy()
            end
        end

        local count = 0
        for _, plr in ipairs(allPlrs) do
            local dName = plr.DisplayName or ""
            local uName = plr.Name or ""
            local matchSearch = (q == "") or (string.find(string.lower(dName), q, 1, true) ~= nil) or (string.find(string.lower(uName), q, 1, true) ~= nil)

            if matchSearch then
                count = count + 1
                local isMe = (plr == LocalPlayer)
                local isBl = (_G.PlayerBlacklist and (_G.PlayerBlacklist[plr.UserId] or _G.PlayerBlacklist[plr.Name])) == true
                local isSpectatingThis = (isSpectatingPlr == plr)

                local itemF = create("Frame", {
                    Name = "PlrCard_" .. plr.Name,
                    Size = UDim2.new(1, 0, 0, 78),
                    BackgroundColor3 = isMe and Color3.fromRGB(18, 16, 20) or THEME.CardBg,
                    BorderSizePixel = 0,
                    LayoutOrder = 10 + count,
                    Parent = listCard.Frame,
                })
                addCorner(itemF, 6)
                addStroke(itemF, isBl and Color3.fromRGB(180, 45, 45) or (isSpectatingThis and THEME.Accent or THEME.Border), isBl and 1.5 or 1)

                local headImg = create("ImageLabel", {
                    Size = UDim2.fromOffset(40, 40),
                    Position = UDim2.fromOffset(8, 8),
                    BackgroundColor3 = Color3.fromRGB(10, 8, 11),
                    BackgroundTransparency = 0.2,
                    BorderSizePixel = 0,
                    Parent = itemF,
                })
                addCorner(headImg, 5)
                addStroke(headImg, THEME.Border, 1)

                task.spawn(function()
                    pcall(function()
                        local thumb = Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
                        if headImg and headImg.Parent then
                            headImg.Image = thumb
                        end
                    end)
                end)

                local details = create("Frame", {
                    Position = UDim2.fromOffset(54, 6),
                    Size = UDim2.new(1, -60, 0, 42),
                    BackgroundTransparency = 1,
                    ClipsDescendants = true,
                    Parent = itemF,
                })

                local nameText = plr.DisplayName .. " (@" .. plr.Name .. ")" .. (isMe and " [YOU]" or "")
                newText(details, nameText, 10, isMe and THEME.Accent or THEME.TextPrimary, Enum.Font.GothamBold, {
                    Position = UDim2.new(0, 0, 0, 0),
                    Size = UDim2.new(1, 0, 0, 14),
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })

                local bVal = 0
                local ls = plr:FindFirstChild("leaderstats")
                if ls then
                    local bStat = ls:FindFirstChild("Bounty/Honor") or ls:FindFirstChild("Bounty")
                    if bStat then bVal = tonumber(bStat.Value) or 0 end
                end
                local bountyFmt = tostring(bVal)
                if bVal >= 1000000 then
                    bountyFmt = string.format("%.2fM", bVal / 1000000)
                elseif bVal >= 1000 then
                    bountyFmt = string.format("%dK", math.floor(bVal / 1000))
                end
                local teamStr = tostring(plr.Team and plr.Team.Name or "Neutral")
                newText(details, "Bounty: " .. bountyFmt .. "  |  Team: " .. teamStr, 8.5, Color3.fromRGB(230, 190, 80), Enum.Font.GothamMedium, {
                    Position = UDim2.new(0, 0, 0, 15),
                    Size = UDim2.new(1, 0, 0, 13),
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })

                local detectedFruit = "None"
                local pChar = plr.Character
                if pChar then
                    for _, ch in ipairs(pChar:GetChildren()) do
                        if ch:IsA("Tool") and (ch:FindFirstChild("Fruit") or string.find(string.lower(ch.Name), "fruit") or string.find(string.lower(ch.Name), "dough") or string.find(string.lower(ch.Name), "dragon") or string.find(string.lower(ch.Name), "kitsune")) then
                            detectedFruit = ch.Name:gsub(" Fruit", ""):gsub("No Mi", "")
                            break
                        end
                    end
                end
                local dist = 0
                local myChar = LocalPlayer.Character
                local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)
                if myHrp and pChar and (pChar:FindFirstChild("HumanoidRootPart") or pChar.PrimaryPart) then
                    local pHrp = pChar:FindFirstChild("HumanoidRootPart") or pChar.PrimaryPart
                    dist = math.floor((myHrp.Position - pHrp.Position).Magnitude)
                end
                newText(details, "Fruit: " .. detectedFruit .. "  |  Dist: " .. dist .. " studs", 8, THEME.TextMuted, Enum.Font.Gotham, {
                    Position = UDim2.new(0, 0, 0, 28),
                    Size = UDim2.new(1, 0, 0, 12),
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })

                local btnRow = create("Frame", {
                    Position = UDim2.new(0, 8, 0, 52),
                    Size = UDim2.new(1, -16, 0, 20),
                    BackgroundTransparency = 1,
                    Parent = itemF,
                })

                local btnSpectate = create("TextButton", {
                    Size = UDim2.new(0.5, -3, 1, 0),
                    Position = UDim2.new(0, 0, 0, 0),
                    BackgroundColor3 = isSpectatingThis and THEME.Accent or THEME.SidebarActive,
                    Font = Enum.Font.GothamBold,
                    TextSize = 9.5,
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                    Text = isSpectatingThis and "Viewing" or "Spectate",
                    AutoButtonColor = false,
                    Parent = btnRow,
                })
                addCorner(btnSpectate, 4)
                addStroke(btnSpectate, THEME.Border, 1)

                btnSpectate.MouseButton1Click:Connect(function()
                    if isSpectatingPlr == plr then
                        stopSpectating()
                        renderPlayerList()
                    else
                        stopSpectating()
                        isSpectatingPlr = plr
                        local cam = workspace.CurrentCamera
                        if cam and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid") then
                            cam.CameraSubject = plr.Character:FindFirstChildOfClass("Humanoid")
                            notify("Spectate", "Viewing " .. plr.DisplayName, 1.5)
                        end
                        renderPlayerList()
                    end
                end)

                local btnBlacklist = create("TextButton", {
                    Size = UDim2.new(0.5, -3, 1, 0),
                    Position = UDim2.new(0.5, 3, 0, 0),
                    BackgroundColor3 = isBl and Color3.fromRGB(160, 35, 45) or THEME.SidebarActive,
                    Font = Enum.Font.GothamBold,
                    TextSize = 9.5,
                    TextColor3 = isBl and Color3.fromRGB(255, 220, 225) or THEME.TextMuted,
                    Text = isBl and "Blacklisted" or "Blacklist",
                    AutoButtonColor = false,
                    Parent = btnRow,
                })
                addCorner(btnBlacklist, 4)
                addStroke(btnBlacklist, isBl and Color3.fromRGB(180, 45, 45) or THEME.Border, 1)

                btnBlacklist.MouseButton1Click:Connect(function()
                    local currentlyBl = (_G.PlayerBlacklist and (_G.PlayerBlacklist[plr.UserId] or _G.PlayerBlacklist[plr.Name])) == true
                    local newBl = not currentlyBl
                    if newBl then
                        _G.PlayerBlacklist[plr.UserId] = true
                        _G.PlayerBlacklist[tostring(plr.UserId)] = true
                        _G.PlayerBlacklist[plr.Name] = true
                        _G.PlayerBlacklist[string.lower(plr.Name)] = true
                        _G.PlayerBlacklist[plr.DisplayName] = true
                        _G.PlayerBlacklist[string.lower(plr.DisplayName)] = true
                        notify("Player Blacklist", plr.DisplayName .. " added to aimbot blacklist", 2)
                    else
                        _G.PlayerBlacklist[plr.UserId] = nil
                        _G.PlayerBlacklist[tostring(plr.UserId)] = nil
                        _G.PlayerBlacklist[plr.Name] = nil
                        _G.PlayerBlacklist[string.lower(plr.Name)] = nil
                        _G.PlayerBlacklist[plr.DisplayName] = nil
                        _G.PlayerBlacklist[string.lower(plr.DisplayName)] = nil
                        notify("Player Blacklist", plr.DisplayName .. " removed from blacklist", 2)
                    end
                    renderPlayerList()
                end)
            end
        end

        TabPlayerList.Right.CanvasSize = UDim2.new(0, 0, 0, 40 + count * 86)
    end

    _G.AuroraX_RefreshPlayerList = renderPlayerList

    connect(Players.PlayerAdded, function()
        task.delay(0.5, function() if renderPlayerList then renderPlayerList() end end)
    end)
    connect(Players.PlayerRemoving, function(plr)
        if isSpectatingPlr == plr then stopSpectating() end
        task.delay(0.2, function() if renderPlayerList then renderPlayerList() end end)
    end)

    renderPlayerList()
end
safeInit("PlayerList", initPlayerList)

