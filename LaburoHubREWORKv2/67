                elseif kb.Action == "Super Jump" then
                    local f = _G.AuroraX_GlitchFns; if f and f.SuperJump then pcall(f.SuperJump) end
                elseif kb.Action == "Z Boost" then
                    local f = _G.AuroraX_GlitchFns; if f and f.ZBoost then pcall(f.ZBoost) end
                elseif kb.Action == "Noclip" and _G.AuroraX_Glitches then
