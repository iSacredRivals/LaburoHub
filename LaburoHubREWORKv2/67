    -- Loads or generates the custom asset for a given fruit
    local function getCustomFruitAsset(fruitName)
        if fruitAssetCache[fruitName] then return fruitAssetCache[fruitName] end
        local info = EMBEDDED_FRUITS[fruitName]
        if not info or not info.Data or info.Data == "" then return nil end

        local gca = getcustomasset or getsynasset
        if gca and writefile then
            local dir = "AuroraX/skins"
            if isfolder and makefolder and not isfolder("AuroraX") then pcall(makefolder, "AuroraX") end
            if isfolder and makefolder and not isfolder(dir) then pcall(makefolder, dir) end
            local filePath = dir .. "/" .. fruitName .. ".png"
            if not (isfile and isfile(filePath)) then
                local bytes = decodeBase64(info.Data)
                if bytes and #bytes > 0 then
                    pcall(writefile, filePath, bytes)
                end
            end
            local okAsset, asset = pcall(gca, filePath)
            if okAsset and asset then
                fruitAssetCache[fruitName] = asset
                return asset
            end
        end
        return nil
    end

    local function getCleanFruitName(rawName)
        if not rawName then return "None" end
        local n = string.lower(rawName)
        -- Match against known internal names
        for fruitName, info in pairs(EMBEDDED_FRUITS) do
            if string.lower(info.Internal) == n or string.lower(fruitName) == n then
                return fruitName
            end
        end
        if n:find("kitsune") then return "Kitsune"
        elseif n:find("portal") or n:find("door") then return "Portal"
        elseif n:find("dragon") then return "Dragon"
        elseif n:find("tiger") or n:find("leopard") then return "Leopard"
        elseif n:find("dough") or n:find("mochi") then return "Dough"
        elseif n:find("mammoth") then return "Mammoth"
        elseif n:find("trex") or n:find("t-rex") then return "T-Rex"
        elseif n:find("buddha") then return "Buddha"
        elseif n:find("blizzard") then return "Blizzard"
        elseif n:find("rumble") or n:find("lightning") then return "Rumble"
        elseif n:find("magma") then return "Magma"
        elseif n:find("light") then return "Light"
        elseif n:find("ice") then return "Ice"
        elseif n:find("dark") then return "Dark"
        elseif n:find("flame") then return "Flame"
        elseif n:find("spirit") or n:find("soul") then return "Spirit"
        elseif n:find("venom") then return "Venom"
        elseif n:find("shadow") then return "Shadow"
        elseif n:find("sound") then return "Sound"
        elseif n:find("gas") then return "Gas"
        elseif n:find("yeti") then return "Yeti"
        elseif n:find("pain") or n:find("paw") then return "Pain"
        elseif n:find("spider") or n:find("string") then return "Spider"
        elseif n:find("gravity") then return "Gravity"
        elseif n:find("control") then return "Control"
        elseif n:find("werewolf") then return "Werewolf"
        elseif n:find("empyrean") then return "Empyrean"
        elseif n:find("fiend") then return "Fiend"
        end
        return rawName:gsub("-.*", ""):gsub(" Fruit", "")
    end

    local function scanPlayerFruit()
        local detected = "None"
        local loc = "None"

        -- 1. Check canonical eaten Devil Fruit in LocalPlayer.Data (highest priority in Blox Fruits!)
        pcall(function()
            local data = LocalPlayer:FindFirstChild("Data")
            local df = data and data:FindFirstChild("DevilFruit")
            if df and df.Value and df.Value ~= "" and df.Value ~= "None" then
                local clean = getCleanFruitName(df.Value)
                if EMBEDDED_FRUITS[clean] then
                    detected = clean
                    loc = "EATEN"
                end
            end
        end)

        -- 2. If no eaten fruit found, check held Tool in Character
        if detected == "None" then
            local char = LocalPlayer.Character
            if char then
                for _, c in ipairs(char:GetChildren()) do
                    if c:IsA("Tool") then
                        local attr = tostring(c:GetAttribute("ItemName") or "")
                        local clean1 = getCleanFruitName(attr)
                        local clean2 = getCleanFruitName(c.Name)
                        if EMBEDDED_FRUITS[clean1] then
                            detected = clean1
                            loc = "EQUIPPED"
                            break
                        elseif EMBEDDED_FRUITS[clean2] then
                            detected = clean2
                            loc = "EQUIPPED"
                            break
                        end
                    end
                end
            end
        end

        -- 3. If still none, check stored Tool in Backpack
        if detected == "None" then
            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            if backpack then
                for _, c in ipairs(backpack:GetChildren()) do
                    if c:IsA("Tool") then
                        local attr = tostring(c:GetAttribute("ItemName") or "")
                        local clean1 = getCleanFruitName(attr)
                        local clean2 = getCleanFruitName(c.Name)
                        if EMBEDDED_FRUITS[clean1] then
                            detected = clean1
                            loc = "IN BAG"
                            break
                        elseif EMBEDDED_FRUITS[clean2] then
                            detected = clean2
                            loc = "IN BAG"
                            break
                        end
                    end
                end
            end
        end

        S.DetectedFruit = detected
        S.FruitLocation = loc
        return detected, loc
    end

