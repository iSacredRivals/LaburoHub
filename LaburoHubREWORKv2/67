    -- Global Keybind Dispatcher
    connect(UserInputService.InputBegan, function(inp, gpe)
        if gpe or inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
        for _, kb in ipairs(H.Keybinds) do
            if inp.KeyCode == kb.Key then
                if kb.Action == "Toggle Menu" then
                    toggleMinimize()
                elseif kb.Action == "Combat Target HUD" then
                    H.TargetHUD = not H.TargetHUD
                    targetWidget.Visible = H.TargetHUD
                    notify("Keybind", "Target HUD: " .. (H.TargetHUD and "ON" or "OFF"), 1.5)
