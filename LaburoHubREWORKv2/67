                notify("Music Player", "Playback Stopped", 1.8)
            end
        end
    })

    -- MUTE GAME SFX / AUDIO (Blox Fruits combat & environment silencer - zero-lag scoped audio scan)
    local originalSoundVolumes = setmetatable({}, { __mode = "k" })
    local muteGameConns = {}
    local isGameMuted = false

    local function muteSoundObj(obj)
        if obj:IsA("Sound") and obj ~= currentSound and obj.Name ~= "AuroraX_MusicPlayer" and obj.Name ~= "AuroraX_LobbyMusic" then
            if originalSoundVolumes[obj] == nil then
                originalSoundVolumes[obj] = obj.Volume
            end
            obj.Volume = 0
        end
    end

    local function setGameMuted(muted)
        isGameMuted = muted
        if muted then
            local targets = { SoundService, workspace }
            local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if pGui then table.insert(targets, pGui) end

            for _, container in ipairs(targets) do
                for _, obj in ipairs(container:GetDescendants()) do
                    muteSoundObj(obj)
                end
                local conn = container.DescendantAdded:Connect(function(obj)
                    if isGameMuted and obj:IsA("Sound") then
                        task.defer(function()
                            if isGameMuted and obj and obj.Parent then
                                muteSoundObj(obj)
                            end
                        end)
                    end
                end)
                table.insert(muteGameConns, conn)
            end
            notify("Music Player", "Game SFX Muted (Music Only)", 2)
        else
            for _, conn in ipairs(muteGameConns) do
                pcall(function() conn:Disconnect() end)
            end
            table.clear(muteGameConns)
            for obj, vol in pairs(originalSoundVolumes) do
                if obj and obj.Parent then
                    pcall(function() obj.Volume = vol end)
                end
            end
            table.clear(originalSoundVolumes)
            notify("Music Player", "Game SFX Restored", 2)
        end
    end

