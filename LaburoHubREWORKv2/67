    local camCard = createCard(TabEsp, "Right", "Camera & Lighting", ICONS.Game)
    addSlider(camCard, "Field of View", {
        Min = 70, Max = 120, Default = 70,
        Callback = function(v)
            local cam = workspace.CurrentCamera
            if cam then cam.FieldOfView = v end
        end
    })
end
