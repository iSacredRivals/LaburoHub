                            local offset = myHrp and (stPos - myHrp.Position).Unit or Vector3.new(0, 0, -1)
                            local behindPos = stPos - (offset * 4.5)
                            if key == "Hit" then
                                return CFrame.new(behindPos)
                            elseif key == "Target" then
                                return (_G.BF_Combat and _G.BF_Combat.CurrentTargetPart) or nil
                            elseif key == "UnitRay" then
                                local cp = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position or Vector3.zero
                                return Ray.new(cp, (behindPos - cp).Unit)
                            elseif key == "Origin" then
                                return workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position or Vector3.zero
                            elseif key == "Direction" then
                                local cp = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position or Vector3.zero
                                return (behindPos - cp).Unit
                            end
                        end
                    end
                    -- 2. Combat Silent Aim
                    if _G.G_SilentAimSkill and _G.G_SilentAimTargetPos then
                        if key == "Hit" then
                            return CFrame.new(_G.G_SilentAimTargetPos)
                        elseif key == "Target" then
                            return _G.G_SilentAimTargetPart
                        elseif key == "UnitRay" then
                            local cp = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position or Vector3.zero
                            return Ray.new(cp, (_G.G_SilentAimTargetPos - cp).Unit)
                        elseif key == "Origin" then
                            return workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position or Vector3.zero
                        elseif key == "Direction" then
                            local cp = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position or Vector3.zero
                            return (_G.G_SilentAimTargetPos - cp).Unit
                        end
                    end
                end
                return oldIndex(self, key)
            end)
        end
    end)

    -- Universal 3D Beam Tracer Engine
    local tracerModel = nil
    local tracerAtt0, tracerAtt1, tracerBeam = nil, nil, nil
    local function ensureBeamTracer()
        if tracerBeam and tracerBeam.Parent and tracerModel and tracerModel.Parent then return tracerBeam end
        pcall(function() if tracerModel then tracerModel:Destroy() end end)
        tracerModel = Instance.new("Model")
        tracerModel.Name = "AuroraX_BeamTracer"
        tracerModel.Parent = workspace.CurrentCamera or workspace
        tracerAtt0 = Instance.new("Attachment", tracerModel)
        tracerAtt1 = Instance.new("Attachment", tracerModel)
        tracerBeam = Instance.new("Beam", tracerModel)
        tracerBeam.Attachment0 = tracerAtt0
        tracerBeam.Attachment1 = tracerAtt1
        tracerBeam.Width0 = 0.18
        tracerBeam.Width1 = 0.18
        tracerBeam.FaceCamera = true
        tracerBeam.Color = ColorSequence.new(THEME.Accent)
        tracerBeam.Transparency = NumberSequence.new(0.15)
        tracerBeam.Enabled = false
        return tracerBeam
    end

    -- Silent Aim RenderStep Loop (NO Camera CFrame modification!)
    local silentAimIdleCleaned = false
    local function silentAimStep(dt)
        if unloaded then return end
        local cam = workspace.CurrentCamera
        if not cam then return end

        local isShowFov = (BF_Combat.ShowFov == true)
        local enabled = (BF_Combat.AimPlayers or BF_Combat.AimNpc)
        local blacklisted = isSkillBlacklisted()
        local active = enabled and not blacklisted

        if not isShowFov and not active then
            if not silentAimIdleCleaned then
                silentAimIdleCleaned = true
                FovCircle.Visible = false
                if DrawingFovCircle then pcall(function() DrawingFovCircle.Visible = false end) end
                BF_Combat.CurrentTarget = nil
                BF_Combat.CurrentTargetPart = nil
                _G.G_SilentAimTargetPos = nil
                _G.G_SilentAimTargetPart = nil
                _G.G_SilentAimSkill = false
                _G.G_SilentAimM1R = false
                _G.aimbot1TargetPos = nil
                _G.centuAimPosition = nil
                _G.SoruTargetPos = nil
                if tracerBeam then tracerBeam.Enabled = false end
                if TracerLine then TracerLine.Visible = false end
                if TracerFrame then TracerFrame.Visible = false end
            end
            return
        end
        silentAimIdleCleaned = false

        local center = getAimCenter()

        -- Update FOV circle (Rock-solid Native GUI circle, guaranteed 100% visible on Mobile & PC!)
        if isShowFov then
            local fovRad = BF_Combat.FovRadius or 150
            local d = fovRad * 2
            FovCircle.Position = UDim2.fromOffset(center.X, center.Y)
            FovCircle.Size = UDim2.fromOffset(d, d)
            if FovStroke then FovStroke.Color = BF_Combat.FovColor or Color3.fromRGB(246, 60, 60) end
            FovCircle.Visible = true
            if DrawingFovCircle then
                pcall(function()
                    DrawingFovCircle.Position = center
                    DrawingFovCircle.Radius = fovRad
                    DrawingFovCircle.Color = BF_Combat.FovColor or Color3.fromRGB(246, 60, 60)
                    DrawingFovCircle.Visible = true
                end)
            end
        else
            FovCircle.Visible = false
            if DrawingFovCircle then
                pcall(function() DrawingFovCircle.Visible = false end)
            end
        end

        local myChar = LocalPlayer.Character
        local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)

        if active then
            local target, targetPart = getBestCombatTarget()
            BF_Combat.CurrentTarget = target
            BF_Combat.CurrentTargetPart = targetPart

            if targetPart then
                local predPos = getPredictedTargetPos(targetPart)

                -- Expose Silent Aim target positions for network redirection and compatibility
                _G.G_SilentAimTargetPos = predPos
                _G.G_SilentAimTargetPart = targetPart
                _G.G_SilentAimSkill = true
                _G.G_SilentAimM1R = true
                _G.aimbot1TargetPos = predPos
                _G.centuAimPosition = nil
                _G.SoruTargetPos = nil

                -- Orient character towards target during skill cast strictly for skills (NEVER on M1!)
                local isRealSkill = (BF_Combat.ActiveSkillKey and BF_Combat.ActiveSkillKey ~= "M1" and BF_Combat.ActiveSkillKey ~= "TAP") or
                    (BF_Combat.RecentSkillKey and BF_Combat.RecentSkillKey ~= "M1" and BF_Combat.RecentSkillKey ~= "TAP" and (os.clock() - (BF_Combat.RecentSkillTime or 0) < 0.85))
                if isRealSkill then
                    faceTarget(predPos)
                end

                -- Single Unified In-World 3D Tracer (Eliminates double tracers, connects directly to target)
                if BF_Combat.Tracers and myHrp then
                    ensureBeamTracer()
                    if tracerAtt0 and tracerAtt1 and tracerBeam then
                        tracerAtt0.WorldPosition = myHrp.Position
                        tracerAtt1.WorldPosition = targetPart.Position
                        tracerBeam.Color = ColorSequence.new(THEME.Accent)
                        tracerBeam.Enabled = true
                        if TracerLine then TracerLine.Visible = false end
                        if TracerFrame then TracerFrame.Visible = false end
                    else
                        local p, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                        if onScreen and p.Z > 0 then
                            if TracerLine then
                                TracerLine.From = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y)
                                TracerLine.To = Vector2.new(p.X, p.Y)
                                TracerLine.Color = THEME.Accent
                                TracerLine.Visible = true
                            elseif TracerFrame then
                                local from = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y)
                                local to = Vector2.new(p.X, p.Y)
                                local delta = to - from
                                local midpoint = (from + to) / 2
                                local angle = math.deg(math.atan2(delta.Y, delta.X))
                                TracerFrame.Position = UDim2.fromOffset(midpoint.X, midpoint.Y)
                                TracerFrame.Size = UDim2.fromOffset(delta.Magnitude, 1.8)
                                TracerFrame.Rotation = angle
                                TracerFrame.BackgroundColor3 = THEME.Accent
                                TracerFrame.Visible = true
                            end
                        else
                            if TracerLine then TracerLine.Visible = false end
                            if TracerFrame then TracerFrame.Visible = false end
                        end
                    end
                else
                    if tracerBeam then tracerBeam.Enabled = false end
                    if TracerLine then TracerLine.Visible = false end
                    if TracerFrame then TracerFrame.Visible = false end
                end
            else
                _G.G_SilentAimTargetPos = nil
                _G.G_SilentAimTargetPart = nil
                _G.G_SilentAimSkill = false
                _G.G_SilentAimM1R = false
                _G.aimbot1TargetPos = nil
                _G.centuAimPosition = nil
                _G.SoruTargetPos = nil
                if tracerBeam then tracerBeam.Enabled = false end
                if TracerLine then TracerLine.Visible = false end
                if TracerFrame then TracerFrame.Visible = false end
            end
        else
            BF_Combat.CurrentTarget = nil
            BF_Combat.CurrentTargetPart = nil
            _G.G_SilentAimTargetPos = nil
            _G.G_SilentAimTargetPart = nil
            _G.G_SilentAimSkill = false
            _G.G_SilentAimM1R = false
            _G.aimbot1TargetPos = nil
            _G.centuAimPosition = nil
            _G.SoruTargetPos = nil
            if tracerBeam then tracerBeam.Enabled = false end
            if TracerLine then TracerLine.Visible = false end
            if TracerFrame then TracerFrame.Visible = false end
        end
    end

    RunService:BindToRenderStep("AuroraX_SilentAim", Enum.RenderPriority.Camera.Value + 1, silentAimStep)
