    local function adjustSelectedScale(delta)
        local targets = selectedWidgetForScale and {selectedWidgetForScale} or {}
        if #targets == 0 then
            for _, w in ipairs(getDraggableHUDWidgets()) do
                table.insert(targets, w.Object)
            end
        end
        for _, obj in ipairs(targets) do
            local s = obj:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", obj)
            s.Scale = math.clamp(math.round((s.Scale + delta) * 10) / 10, 0.5, 2.5)
        end
        updateScaleDisplay()
    end

