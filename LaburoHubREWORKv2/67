    local function toggleEditControls(on)
        H.EditMode = on
        ensureEditToolbar(on)

        for _, conn in ipairs(editConnections) do pcall(function() conn:Disconnect() end) end
        table.clear(editConnections)
        for _, ov in ipairs(editOverlays) do pcall(function() ov:Destroy() end) end
        table.clear(editOverlays)
        if editScreenGui then
            pcall(function() editScreenGui:Destroy() end)
            editScreenGui = nil
        end
        selectedWidgetForScale = nil

        if on then
            editScreenGui = Instance.new("ScreenGui")
            editScreenGui.Name = "AuroraX_HUDStudioOverlayGui"
            editScreenGui.ResetOnSpawn = false
            editScreenGui.IgnoreGuiInset = true
            editScreenGui.DisplayOrder = 999999
            editScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            local parentOk = pcall(function() editScreenGui.Parent = ScreenGui.Parent end)
            if not parentOk or not editScreenGui.Parent then
                editScreenGui.Parent = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            end

            local widgets = getDraggableHUDWidgets()
            for _, entry in ipairs(widgets) do
                local widget = entry.Object
                if widget:IsA("GuiObject") then
                    -- Unbind restrictive parent layouts and clipping
                    local curr = widget.Parent
                    while curr and curr:IsA("GuiObject") do
                        curr.ClipsDescendants = false
                        for _, l in ipairs(curr:GetChildren()) do
                            if l:IsA("UIListLayout") or l:IsA("UIGridLayout") or l:IsA("UITableLayout") then
                                l.Enabled = false
                            end
                        end
                        curr = curr.Parent
                    end

                    local wW = math.max(widget.AbsoluteSize.X, 32)
                    local wH = math.max(widget.AbsoluteSize.Y, 32)

                    local ov = create("TextButton", {
                        Name = "Aurora_EditOverlay_" .. entry.Key,
                        Size = UDim2.fromOffset(wW, wH),
                        Position = UDim2.fromOffset(widget.AbsolutePosition.X, widget.AbsolutePosition.Y),
                        BackgroundColor3 = Color3.fromRGB(0, 150, 255),
                        BackgroundTransparency = 0.88,
                        BorderSizePixel = 0,
                        Text = "",
                        AutoButtonColor = false,
                        Active = true,
                        Selectable = false,
                        ZIndex = 99999,
                        Parent = editScreenGui,
                    })
                    addCorner(ov, 6)
                    local st = addStroke(ov, THEME.Accent, 1.8)

                    local badgeText = entry.Label
                    local badgeW = math.clamp(#badgeText * 6.8 + 14, 50, 140)
                    local badgeY = (widget.AbsolutePosition.Y < 24) and 2 or -20

                    local badge = create("Frame", {
                        Name = "TagBadge",
                        Size = UDim2.fromOffset(badgeW, 18),
                        Position = UDim2.new(0, 0, 0, badgeY),
                        BackgroundColor3 = Color3.fromRGB(16, 12, 20),
                        BackgroundTransparency = 0.12,
                        BorderSizePixel = 0,
                        ZIndex = 100000,
                        Parent = ov,
                    })
                    addCorner(badge, 4)
                    addStroke(badge, THEME.Accent, 1)

                    newText(badge, badgeText, 8.5, Color3.fromRGB(255, 230, 110), Enum.Font.GothamBold, {
                        Size = UDim2.fromScale(1, 1),
                        Position = UDim2.fromScale(0, 0),
                        TextXAlignment = Enum.TextXAlignment.Center,
                    })

                    table.insert(editOverlays, ov)

                    local dragging = false
                    local dragStartInput = nil
                    local startWidgetAbs = nil
                    local parentAbs = Vector2.zero
                    local parentSize = Vector2.new(1920, 1080)

                    local cBegan = ov.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = true
                            dragStartInput = input.Position
                            startWidgetAbs = widget.AbsolutePosition
                            selectedWidgetForScale = widget
                            st.Color = Color3.fromRGB(100, 230, 255)
                            st.Thickness = 2.4
                            ov.BackgroundTransparency = 0.70
                            updateScaleDisplay()

                            local pObj = widget.Parent
                            if pObj and pObj:IsA("GuiObject") then
                                parentAbs = pObj.AbsolutePosition
                                parentSize = pObj.AbsoluteSize
                            else
                                local cam = workspace.CurrentCamera
                                parentAbs = Vector2.zero
                                parentSize = (cam and cam.ViewportSize) or Vector2.new(1920, 1080)
                            end
                        end
                    end)
                    table.insert(editConnections, cBegan)

                    local cChanged = UserInputService.InputChanged:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                            local d = input.Position - dragStartInput
                            local cam = workspace.CurrentCamera
                            local vp = (cam and cam.ViewportSize) or Vector2.new(1920, 1080)

                            local targetScreenX = startWidgetAbs.X + d.X
                            local targetScreenY = startWidgetAbs.Y + d.Y

                            local curW = widget.AbsoluteSize.X
                            local curH = widget.AbsoluteSize.Y
                            local clampedScreenX = math.clamp(targetScreenX, 0, math.max(0, vp.X - curW))
                            local clampedScreenY = math.clamp(targetScreenY, 0, math.max(0, vp.Y - curH))

                            ov.Position = UDim2.fromOffset(clampedScreenX, clampedScreenY)

                            local relX = clampedScreenX - parentAbs.X
                            local relY = clampedScreenY - parentAbs.Y

                            if parentSize.X > 0 and parentSize.Y > 0 then
                                widget.Position = UDim2.new(relX / parentSize.X, 0, relY / parentSize.Y, 0)
                            else
                                widget.Position = UDim2.fromOffset(relX, relY)
                            end
                        end
                    end)
                    table.insert(editConnections, cChanged)

                    local cEnded = UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            if dragging then
                                dragging = false
                                st.Color = THEME.Accent
                                st.Thickness = 1.8
                                ov.BackgroundTransparency = 0.88
                            end
                        end
                    end)
                    table.insert(editConnections, cEnded)

                    -- Keep overlay locked to widget when not actively dragged
                    local pConn = widget:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
                        if not dragging and ov.Parent then
                            ov.Position = UDim2.fromOffset(widget.AbsolutePosition.X, widget.AbsolutePosition.Y)
                        end
                    end)
                    table.insert(editConnections, pConn)

                    local sConn = widget:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                        if not dragging and ov.Parent then
                            ov.Size = UDim2.fromOffset(widget.AbsoluteSize.X, widget.AbsoluteSize.Y)
                        end
                    end)
                    table.insert(editConnections, sConn)
                end
            end
            notify("HUD Studio", "Controls unlocked! Drag buttons freely & scale with +/-", 3)
        else
            saveAllLayoutPositions()
        end
    end

