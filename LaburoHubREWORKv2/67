    local function scanPlayerItem(cat)
        cat = cat or S.SelectedCategory or "Fruits"
        local detected = "None"
        local loc = "None"

        if cat == "Fruits" then
            pcall(function()
                local data = LocalPlayer:FindFirstChild("Data")
                local df = data and data:FindFirstChild("DevilFruit")
                if df and df.Value and df.Value ~= "" and df.Value ~= "None" then
                    local clean = getCleanFruitName(df.Value)
                    if EMBEDDED_FRUITS[clean] then
                        detected = clean
                        loc = "EATEN"
                    end
                end
            end)
            if detected == "None" then
                local char = LocalPlayer.Character
                if char then
                    for _, c in ipairs(char:GetChildren()) do
                        if c:IsA("Tool") then
                            local attr = tostring(c:GetAttribute("ItemName") or "")
                            local clean1 = getCleanFruitName(attr)
                            local clean2 = getCleanFruitName(c.Name)
                            if EMBEDDED_FRUITS[clean1] then
                                detected = clean1; loc = "EQUIPPED"; break
                            elseif EMBEDDED_FRUITS[clean2] then
                                detected = clean2; loc = "EQUIPPED"; break
                            end
                        end
                    end
                end
            end
            if detected == "None" then
                local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
                if bp then
                    for _, c in ipairs(bp:GetChildren()) do
                        if c:IsA("Tool") then
                            local attr = tostring(c:GetAttribute("ItemName") or "")
                            local clean1 = getCleanFruitName(attr)
                            local clean2 = getCleanFruitName(c.Name)
                            if EMBEDDED_FRUITS[clean1] then
                                detected = clean1; loc = "IN BAG"; break
                            elseif EMBEDDED_FRUITS[clean2] then
                                detected = clean2; loc = "IN BAG"; break
                            end
                        end
                    end
                end
            end
        else
            local targetList = (cat == "Swords" and SWORDS_LIST) or (cat == "Guns" and GUNS_LIST) or MELEE_LIST
            local targetTip = CATEGORY_META[cat].Tip

            local char = LocalPlayer.Character
            if char then
                for _, c in ipairs(char:GetChildren()) do
                    if c:IsA("Tool") then
                        if c.ToolTip == targetTip or tostring(c:GetAttribute("WeaponType")) == targetTip or tostring(c:GetAttribute("ItemType")) == targetTip then
                            detected = c.Name
                            loc = "EQUIPPED"
                            break
                        end
                        for _, wName in ipairs(targetList) do
                            if wName ~= "Auto" and string.lower(c.Name) == string.lower(wName) then
                                detected = wName
                                loc = "EQUIPPED"
                                break
                            end
                        end
                        if detected ~= "None" then break end
                    end
                end
            end

            if detected == "None" then
                local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
                if bp then
                    for _, c in ipairs(bp:GetChildren()) do
                        if c:IsA("Tool") then
                            if c.ToolTip == targetTip or tostring(c:GetAttribute("WeaponType")) == targetTip or tostring(c:GetAttribute("ItemType")) == targetTip then
                                detected = c.Name
                                loc = "IN BAG"
                                break
                            end
                            for _, wName in ipairs(targetList) do
                                if wName ~= "Auto" and string.lower(c.Name) == string.lower(wName) then
                                    detected = wName
                                    loc = "IN BAG"
                                    break
                                end
                            end
                            if detected ~= "None" then break end
                        end
                    end
                end
            end

            if detected == "None" then
                local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                local bpGui = pGui and pGui:FindFirstChild("Backpack")
                local hotbar = bpGui and bpGui:FindFirstChild("Hotbar")
                local cont = hotbar and hotbar:FindFirstChild("Container")
                if cont then
                    local targetSlotIdx = CATEGORY_META[cat].Slot
                    local slots = {}
                    for _, c in ipairs(cont:GetChildren()) do
                        if c:IsA("GuiObject") and (c:FindFirstChild("Image") or c:FindFirstChildOfClass("ImageLabel")) then
                            table.insert(slots, c)
                        end
                    end
                    table.sort(slots, function(a, b) return (a.LayoutOrder or 0) < (b.LayoutOrder or 0) end)
                    if slots[targetSlotIdx] then
                        local title = slots[targetSlotIdx]:FindFirstChild("Title")
                        if title and title:IsA("TextLabel") and title.Text ~= "" then
                            detected = title.Text
                            loc = "HOTBAR"
                        end
                    end
                end
            end
        end

        return detected, loc
    end

    local function getTargetItem(cat)
        cat = cat or S.SelectedCategory or "Fruits"
