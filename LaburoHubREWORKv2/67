-- Universal Draggable Helper (With Lock Support)
local function makeDraggable(targetFrame, handle)
    handle = handle or targetFrame
    local dragging, dragStart, startPos = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if _G.AuroraX_LockControls and targetFrame ~= Main then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if _G.AuroraX_LockControls and targetFrame ~= Main then return end
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            targetFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end
makeDraggable(Main, TopBar)

-- Global HUD & Controls Layout Cache & Persistence
_G.AuroraX_Layout = _G.AuroraX_Layout or nil

local function loadStoredHUDLayout()
    if _G.AuroraX_Layout and next(_G.AuroraX_Layout) then return _G.AuroraX_Layout end
    if readfile and isfile and isfile("AuroraX/hud_layout.json") then
        pcall(function()
            local raw = readfile("AuroraX/hud_layout.json")
            _G.AuroraX_Layout = HttpService:JSONDecode(raw)
        end)
    end
    _G.AuroraX_Layout = _G.AuroraX_Layout or {}
    return _G.AuroraX_Layout
end

local function applySavedPosition(guiObj, keyName)
    if not guiObj then return end
    keyName = keyName or guiObj.Name
    local layout = loadStoredHUDLayout()
    local data = layout and layout[keyName]
    if data then
        pcall(function()
            guiObj.Position = UDim2.new(data.ScaleX or 0, data.OffsetX or 0, data.ScaleY or 0, data.OffsetY or 0)
            if data.SizeScale then
                local s = guiObj:FindFirstChildOfClass("UIScale")
                if not s then s = Instance.new("UIScale", guiObj) end
                s.Scale = data.SizeScale
            end
        end)
    end
end

