    local function getDraggableHUDWidgets()
        local widgets = {}
        local seen = {}

        local function addWidget(obj, keyName, label)
            if obj and obj:IsA("GuiObject") and not seen[obj] then
                seen[obj] = true
                local k = keyName or obj.Name
                if not defaultHUDLayout[k] then
                    local s = obj:FindFirstChildOfClass("UIScale")
                    defaultHUDLayout[k] = {
                        Position = obj.Position,
                        Scale = s and s.Scale or 1
                    }
                end
                table.insert(widgets, {
                    Object = obj,
                    Key = k,
                    Label = label or HUD_FRIENDLY_NAMES[obj.Name] or obj.Name
                })
            end
        end

        -- Custom Aurora Widgets
        if targetWidget then addWidget(targetWidget, "AuroraTargetWidget", "TARGET HUD") end
        if Hud then addWidget(Hud, "Hud", "STATS HUD") end
        if MiniHolder then addWidget(MiniHolder, "MiniHolder", "MINI STATS") end

        if ScreenGui then
            for _, name in ipairs({"AuroraX_MobileMacroButton", "AuroraX_ZBoostButton", "AuroraX_SuperJumpButton"}) do
                local b = ScreenGui:FindFirstChild(name)
                if b then addWidget(b, name, HUD_FRIENDLY_NAMES[name] or name) end
            end
        end

        local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if pGui then
            -- Backpack / Hotbar
            local bpGui = pGui:FindFirstChild("Backpack")
            if bpGui then
                local hotbar = bpGui:FindFirstChild("Hotbar") or bpGui:FindFirstChild("Inventory")
                if hotbar then addWidget(hotbar, "Hotbar", "HOTBAR") end
            end

            -- Mobile Context Buttons (ContextButtonFrame)
            local mcb = pGui:FindFirstChild("MobileContextButtons")
            if mcb then
                local cbf = mcb:FindFirstChild("ContextButtonFrame") or mcb:FindFirstChildWhichIsA("Frame")
                if cbf then
                    for _, child in ipairs(cbf:GetChildren()) do
                        if child:IsA("GuiObject") and not child.Name:find("UI") and not child.Name:find("Layout") then
                            addWidget(child, child.Name, HUD_FRIENDLY_NAMES[child.Name] or child.Name)
                        end
                    end
                end
            end

            -- Main HUD Elements
            local main = pGui:FindFirstChild("Main")
            if main then
                local bar = main:FindFirstChild("Bar") or main:FindFirstChild("HealthBar")
                if bar then addWidget(bar, "Bar", "HEALTH & ENERGY") end

                local compass = main:FindFirstChild("Compass")
                if compass then addWidget(compass, "Compass", "COMPASS") end

                local cbf = main:FindFirstChild("ContextButtonFrame")
                if cbf then
                    for _, child in ipairs(cbf:GetChildren()) do
                        if child:IsA("GuiObject") and not child.Name:find("UI") and not child.Name:find("Layout") then
                            addWidget(child, child.Name, HUD_FRIENDLY_NAMES[child.Name] or child.Name)
                        end
                    end
                end

                local bhl = main:FindFirstChild("BottomHUDList")
                if bhl then
                    local ucb = bhl:FindFirstChild("UniversalContextButtons")
                    if ucb then
                        for _, child in ipairs(ucb:GetChildren()) do
                            if child:IsA("GuiObject") and not child.Name:find("UI") and not child.Name:find("Layout") then
                                addWidget(child, child.Name, HUD_FRIENDLY_NAMES[child.Name] or child.Name)
                            end
                        end
                    end
                end

                local skills = main:FindFirstChild("Skills")
                if skills then addWidget(skills, "Skills", "SKILLS CONTAINER") end

                local hotbar = main:FindFirstChild("Hotbar") or main:FindFirstChild("BottomBar")
                if hotbar then addWidget(hotbar, "MainHotbar", "HOTBAR") end

                local beli = main:FindFirstChild("Beli")
                if beli then addWidget(beli, "Beli", "BELI") end

                local level = main:FindFirstChild("Level") or main:FindFirstChild("LevelFrame")
                if level then addWidget(level, "Level", "LEVEL HUD") end

                local btnBar = main:FindFirstChild("HUDButtonBar") or main:FindFirstChild("Buttons")
                if btnBar then addWidget(btnBar, "HUDButtonBar", "MENU BUTTONS") end
