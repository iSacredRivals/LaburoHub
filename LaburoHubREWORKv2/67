        local cleanId = tostring(id):gsub("%D+", "")
        if cleanId == "" then
            notify("Music Player", "Invalid Sound ID!", 2.5)
            return
        end
        currentIdText = cleanId
        currentTrackName = name or ("Track #" .. cleanId)
        local snd = getMusicPlayer()
        snd:Stop()
        snd.SoundId = "rbxassetid://" .. cleanId
        snd:Play()
        statusLabel.Text = "Playing: " .. currentTrackName
        statusLabel.TextColor3 = Color3.fromRGB(80, 240, 120)
