    _G.G_SilentAimSkill = false
    _G.G_SilentAimM1R = false
    _G.aimbot1TargetPos = nil
    _G.centuAimPosition = nil
    _G.SoruTargetPos = nil
    if VisualGui then pcall(function() VisualGui:Destroy() end) end
    if TracerLine and TracerLine.Remove then pcall(function() TracerLine:Remove() end) end
    pcall(function()
        local s = game:GetService("SoundService"):FindFirstChild("AuroraX_MusicPlayer")
        if s then s:Stop(); s:Destroy() end
    end)
    pcall(function() ScreenGui:Destroy() end)
    if env.AuroraX_Unload == unload then env.AuroraX_Unload = nil end
    env.AuroraX = nil
end
