        -- Priority 3: Nearest alive player with PVP enabled (Aurora X pattern, up to 3500 studs)
        local bestHrp, bestDist = nil, 3500
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p:GetAttribute("PvpDisabled") ~= true then
