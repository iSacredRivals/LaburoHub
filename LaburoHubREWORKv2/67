local function addTab(name, iconId)
    sideOrder = sideOrder + 1
    local btn = create("TextButton", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundColor3 = THEME.SidebarActive,
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = sideOrder,
        Parent = SideScroll,
    })
    addCorner(btn, 6)
    local st = themed(addStroke(btn, THEME.BorderActive, 1, 1), "Color", "BorderActive")

    local bar = create("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(2, 0),
        BorderSizePixel = 0,
        Parent = btn,
    })
    addCorner(bar, 2)
    themed(bar, "BackgroundColor3", "Accent")

    local ico = newIcon(btn, iconId, 12, THEME.TextMuted, {Position = UDim2.new(0, 10, 0.5, -6)})
    local title = newText(btn, name, 10, THEME.TextMuted, Enum.Font.GothamMedium, {
        Position = UDim2.fromOffset(29, 0), Size = UDim2.new(1, -31, 1, 0),
    })
    registerLocalized(title, name)

    local page = create("Frame", {
        Name = name,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Visible = false,
        Parent = Content,
    })

    local function column(pos)
        local col = create("ScrollingFrame", {
            Position = pos,
            Size = UDim2.new(0.5, -3, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            ScrollBarImageTransparency = 0.35,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            Parent = page,
        })
        themed(col, "ScrollBarImageColor3", "Accent")
        local listLayout = addList(col, 7)
        addPadding(col, 1, 6, 1, 6)
        connect(listLayout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
            col.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 32)
        end)
        connect(col:GetPropertyChangedSignal("CanvasPosition"), closePopup)
        return col
    end

    local tab = {
        Name = name, Btn = btn, Stroke = st, Bar = bar, Icon = ico, Title = title,
        Page = page, Left = column(UDim2.new()), Right = column(UDim2.new(0.5, 3, 0, 0)),
        CardCount = 0, Cards = {},
    }

    btn.MouseEnter:Connect(function()
        if ActiveTab ~= tab then
            tween(title, TWEEN_FAST, {TextColor3 = THEME.TextPrimary})
            tween(ico, TWEEN_FAST, {ImageColor3 = THEME.TextPrimary})
        end
    end)
    btn.MouseLeave:Connect(function()
        if ActiveTab ~= tab then
            tween(title, TWEEN_FAST, {TextColor3 = THEME.TextMuted})
            tween(ico, TWEEN_FAST, {ImageColor3 = THEME.TextMuted})
        end
    end)
    btn.MouseButton1Click:Connect(function() selectTab(tab) end)

    table.insert(Tabs, tab)
    return tab
end

