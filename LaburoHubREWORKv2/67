        -- Verification logic
        local isVerifying = false
        local function doVerify()
            if isVerifying then return end
            local enteredKey = keyBox.Text:gsub("%s+", "")
            if #enteredKey == 0 or enteredKey == "EnterKey" then
                keyBoxStroke.Color = Color3.fromRGB(255, 60, 70)
                keyBox.PlaceholderText = "Paste Key First!"
                task.delay(1.8, function()
                    if keyBox and keyBox.Parent then
                        keyBoxStroke.Color = Color3.fromRGB(70, 65, 75)
                        keyBox.PlaceholderText = "Enter Key"
                    end
                end)
                return
            end

            isVerifying = true
            keyBox.Text = "Checking..."
            keyBox.TextColor3 = Color3.fromRGB(255, 200, 60)
            keyBoxStroke.Color = Color3.fromRGB(255, 200, 60)

            task.spawn(function()
                local ok, data, err = checkKeyAPI(enteredKey)
                if ok then
                    if canSave and writefile then
                        pcall(writefile, KEY_FILE, enteredKey)
                    end
                    keyBox.Text = "VERIFIED!"
                    keyBox.TextColor3 = Color3.fromRGB(80, 240, 120)
                    keyBoxStroke.Color = Color3.fromRGB(80, 240, 120)
