            local hum = myChar:FindFirstChildOfClass("Humanoid")
            if hum and hum:GetAttribute("SoruCharges") ~= nil then
                hum:SetAttribute("SoruCharges", nil)
            end
        end)

        local currentPos = myHrp.Position
        local fullDist = (targetPos - currentPos).Magnitude
        local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")

        if fullDist <= 950 then
            pcall(function()
                if commF then
                    commF:InvokeServer("Flashstep", targetPos)
                else
                    myHrp.CFrame = CFrame.new(targetPos)
                end
            end)
        else
            local steps = math.ceil(fullDist / 900)
            local dir = (targetPos - currentPos).Unit
            for i = 1, steps do
                local nextDist = math.min(i * 900, fullDist)
                local nextPos = currentPos + (dir * nextDist)
                pcall(function()
                    if commF then
                        commF:InvokeServer("Flashstep", nextPos)
                    else
                        myHrp.CFrame = CFrame.new(nextPos)
                    end
                end)
                task.wait(0.015)
            end
        end
    end

