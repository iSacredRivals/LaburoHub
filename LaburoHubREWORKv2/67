                local function updateHotbarIcons()
                    for _, slot in ipairs(container:GetChildren()) do
                        local icon = slot:FindFirstChild("Icon") or slot:FindFirstChild("Image") or slot:FindFirstChildOfClass("ImageLabel")
                        if icon and icon:IsA("ImageLabel") then
                            if not hotbarIconsOriginals[icon] then hotbarIconsOriginals[icon] = icon.Image end
                            icon.Image = "rbxassetid://84308155859778"
                            icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
                        end
                    end
                end
                updateHotbarIcons()
                noGfxConnections.HotbarChildAdded = container.ChildAdded:Connect(function()
                    task.defer(updateHotbarIcons)
                end)
            end)
        end
    end

